<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_kw_partner_duplicate_form" model="ir.ui.view">
            <field name="name">kw.partner.duplicate.form</field>
            <field name="model">kw.partner.duplicate</field>
            <field name="arch" type="xml">
                <form string="Duplicate Partners">
                    <header>
                        <button name="action_merge_manually" type="object" string="Merge Now" class="btn-primary" />
                    </header>
                    <sheet>
                        <group>
                            <field name="mobile"/>
                            <field name="partners_count"/>
                        </group>
                        <notebook>
                            <page string="Partners">
                                <field name="partner_ids">
                                    <list>
                                        <field name="name" />
                                        <field name="email" />
                                        <field name="mobile" />
                                        <field name="create_uid" />
                                        <field name="create_date" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_kw_partner_duplicate_tree" model="ir.ui.view">
            <field name="name">kw.partner.duplicate.tree</field>
            <field name="model">kw.partner.duplicate</field>
            <field name="arch" type="xml">
                <list string="Duplicate Partners">
                    <field name="mobile"/>
                    <field name="partners_count"/>
                    <button name="action_merge_manually" type="object" string="Merge" class="btn-primary"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_kw_partner_duplicate" model="ir.actions.act_window">
            <field name="name">Duplicate Contacts</field>
            <field name="res_model">kw.partner.duplicate</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Root Menu for the module -->
        <menuitem id="menu_kw_partner_merge_root" 
                  name="Duplicate Contacts" 
                  web_icon="kw_partner_merge,static/description/icon.png"
                  groups="base.group_system" 
                  sequence="100"/>
        
        <!-- Action Menu Item -->
        <menuitem id="menu_kw_partner_duplicate" 
                  name="Duplicate Contacts" 
                  parent="menu_kw_partner_merge_root" 
                  action="action_kw_partner_duplicate" 
                  groups="base.group_system" 
                  sequence="1" />
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_bussma_entry_opportunity_wizard_form" model="ir.ui.view">
            <field name="name">bussma.entry.opportunity.wizard.form</field>
            <field name="model">bussma.entry.opportunity.wizard</field>
            <field name="arch" type="xml">
                <form string="Link / Create Opportunity for Client">
                    <sheet>
                        <field name="entry_id" invisible="1"/>
                        <field name="has_existing_opportunities" invisible="1"/>
                        <group>
                            <field name="partner_id" readonly="1"/>
                        </group>

                        <div class="alert alert-info" invisible="not has_existing_opportunities">
                            <strong>Client has active existing opportunities.</strong> You can choose to link to an existing opportunity or create a new one.
                        </div>
                        <div class="alert alert-warning" invisible="has_existing_opportunities">
                            <strong>No active opportunities found for this client.</strong> A new opportunity will be created.
                        </div>

                        <group invisible="not has_existing_opportunities">
                            <field name="existing_opportunity_ids" widget="many2many_tags" readonly="1"/>
                        </group>

                        <group>
                            <field name="action_type" widget="radio" invisible="not has_existing_opportunities"/>
                            <field name="opportunity_id"
                                   options="{'no_create': True}"
                                   required="action_type == 'link' and has_existing_opportunities"
                                   invisible="action_type != 'link' or not has_existing_opportunities"/>
                            <field name="new_opportunity_name"
                                   placeholder="Enter new opportunity name..."
                                   required="action_type == 'create' or not has_existing_opportunities"
                                   invisible="action_type == 'link' and has_existing_opportunities"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_apply" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

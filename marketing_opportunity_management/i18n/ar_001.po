#. module: marketing_opportunity_management
#: model:mail.template,body_html:marketing_opportunity_management.email_template_marketing_material_sent_to_pm
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" dir=\"ltr\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px; text-align: left;\">\n"
"                        Sender: <strong>Marketing Department - Bussma</strong><br/><br/>\n"
"                        <t t-set=\"is_opp\" t-value=\"ctx.get('is_opportunity') or (object.marketing_id and (object.marketing_id.is_opportunity_request or object.marketing_id.opportunity_id))\"/>\n"
"                        <t t-if=\"is_opp\">\n"
"                            Dear Opportunity Department Members / <strong><t t-out=\"ctx.get('pm_name') or 'Opportunity Team'\"/></strong>,<br/><br/>\n"
"                            Marketing material \"<strong><t t-out=\"object.name\"/></strong>\" has been completed and is awaiting Opportunity Department approval.<br/><br/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            Dear Project Manager / <strong><t t-out=\"ctx.get('pm_name') or 'Respected User'\"/></strong>,<br/><br/>\n"
"                            Marketing material \"<strong><t t-out=\"object.name\"/></strong>\" has been completed and is awaiting your approval.<br/><br/>\n"
"                        </t>\n"
"                        <strong>Marketing Material Request Details:</strong>\n"
"                        </p><ul>\n"
"                            <li><strong>Material Name:</strong> <t t-out=\"object.name\"/></li>\n"
"                            <li><strong>Marketing Project Name:</strong> <t t-out=\"object.marketing_id.name or '-'\"/></li>\n"
"                            <li t-if=\"is_opp\"><strong>Opportunity Name:</strong> <t t-out=\"ctx.get('source_project_name') or '-'\"/></li>\n"
"                            <li t-else=\"\"><strong>Project Name:</strong> <t t-out=\"ctx.get('source_project_name') or '-'\"/></li>\n"
"                        </ul>\n"
"                        Please review the marketing material and take the appropriate decision to approve or return.\n"
"                    \n"
"                    <div style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                        <t t-set=\"mkt\" t-value=\"object.marketing_id\"/>\n"
"                        <t t-set=\"base_url\" t-value=\"object.get_base_url()\"/>\n"
"                        <t t-if=\"ctx.get('target_url')\">\n"
"                            <t t-set=\"btn_url\" t-value=\"ctx.get('target_url')\"/>\n"
"                        </t>\n"
"                        <t t-elif=\"is_opp and mkt and mkt.opportunity_id\">\n"
"                            <t t-set=\"btn_url\" t-value=\"'%s/web#id=%s&amp;model=bussma.opportunity&amp;view_type=form' % (base_url, mkt.opportunity_id.id)\"/>\n"
"                        </t>\n"
"                        <t t-elif=\"mkt and mkt.bussma_project_id\">\n"
"                            <t t-set=\"btn_url\" t-value=\"'%s/web#id=%s&amp;model=bussma.project&amp;view_type=form' % (base_url, mkt.bussma_project_id.id)\"/>\n"
"                        </t>\n"
"                        <t t-elif=\"mkt and mkt.office_request_id\">\n"
"                            <t t-set=\"btn_url\" t-value=\"'%s/web#id=%s&amp;model=office.request&amp;view_type=form' % (base_url, mkt.office_request_id.id)\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-set=\"btn_url\" t-value=\"'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (base_url, object.id, object._name)\"/>\n"
"                        </t>\n"
"                        <a t-att-href=\"btn_url\" style=\"background-color: #875A7B; padding: 10px 20px 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px; font-weight: bold; display: inline-block;\">\n"
"                            <t t-if=\"is_opp\">View Opportunity</t>\n"
"                            <t t-else=\"\">View Project</t>\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" dir=\"rtl\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px; text-align: right;\">\n"
"                        المرسل: <strong>قسم التسويق - بصمة</strong><br/><br/>\n"
"                        <t t-set=\"is_opp\" t-value=\"ctx.get('is_opportunity') or (object.marketing_id and (object.marketing_id.is_opportunity_request or object.marketing_id.opportunity_id))\"/>\n"
"                        <t t-if=\"is_opp\">\n"
"                            أعضاء إدارة الفرص المحترمين / <strong><t t-out=\"ctx.get('pm_name') or 'فريق إدارة الفرص'\"/></strong>،<br/><br/>\n"
"                            تم اكتمال المادة التسويقية \"<strong><t t-out=\"object.name\"/></strong>\" بانتظار موافقة إدارة الفرص عليها.<br/><br/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            عزيزي مدير المشروع المحترم / <strong><t t-out=\"ctx.get('pm_name') or '-'\"/></strong>،<br/><br/>\n"
"                            تم اكتمال المادة التسويقية \"<strong><t t-out=\"object.name\"/></strong>\" بانتظار موافقتكم عليها.<br/><br/>\n"
"                        </t>\n"
"                        <strong>تفاصيل طلب المادة التسويقية:</strong>\n"
"                        </p><ul>\n"
"                            <li><strong>اسم المادة التسويقية:</strong> <t t-out=\"object.name\"/></li>\n"
"                            <li><strong>اسم المشروع التسويقي:</strong> <t t-out=\"object.marketing_id.name or '-'\"/></li>\n"
"                            <li t-if=\"is_opp\"><strong>اسم الفرصة:</strong> <t t-out=\"ctx.get('source_project_name') or '-'\"/></li>\n"
"                            <li t-else=\"\"><strong>اسم المشروع:</strong> <t t-out=\"ctx.get('source_project_name') or '-'\"/></li>\n"
"                        </ul>\n"
"                        نرجو الاطلاع على المادة التسويقية واتخاذ قرار الاعتماد أو الإرجاع.\n"
"                    \n"
"                    <div style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                        <t t-set=\"mkt\" t-value=\"object.marketing_id\"/>\n"
"                        <t t-set=\"base_url\" t-value=\"object.get_base_url()\"/>\n"
"                        <t t-if=\"ctx.get('target_url')\">\n"
"                            <t t-set=\"btn_url\" t-value=\"ctx.get('target_url')\"/>\n"
"                        </t>\n"
"                        <t t-elif=\"is_opp and mkt and mkt.opportunity_id\">\n"
"                            <t t-set=\"btn_url\" t-value=\"'%s/web#id=%s&amp;model=bussma.opportunity&amp;view_type=form' % (base_url, mkt.opportunity_id.id)\"/>\n"
"                        </t>\n"
"                        <t t-elif=\"mkt and mkt.bussma_project_id\">\n"
"                            <t t-set=\"btn_url\" t-value=\"'%s/web#id=%s&amp;model=bussma.project&amp;view_type=form' % (base_url, mkt.bussma_project_id.id)\"/>\n"
"                        </t>\n"
"                        <t t-elif=\"mkt and mkt.office_request_id\">\n"
"                            <t t-set=\"btn_url\" t-value=\"'%s/web#id=%s&amp;model=office.request&amp;view_type=form' % (base_url, mkt.office_request_id.id)\"/>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-set=\"btn_url\" t-value=\"'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (base_url, object.id, object._name)\"/>\n"
"                        </t>\n"
"                        <a t-att-href=\"btn_url\" style=\"background-color: #875A7B; padding: 10px 20px 10px 20px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px; font-weight: bold; display: inline-block;\">\n"
"                            <t t-if=\"is_opp\">عرض الفرصة</t>\n"
"                            <t t-else=\"\">عرض المشروع</t>\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "


#. module: marketing_opportunity_management
#: code:addons/marketing_opportunity_management/models/bussma_marketing_material.py:0
#: model:mail.template,subject:marketing_opportunity_management.email_template_marketing_material_rejected_by_pm
msgid ""
"Notification: Marketing Material {{ object.name }} ({{ object.code or '' }})"
" Rejected by {{ 'Opportunity Department' if (ctx.get('is_opportunity') or "
"object.is_opportunity_request or (object.marketing_id and "
"(object.marketing_id.is_opportunity_request or "
"object.marketing_id.opportunity_id))) else 'Project Manager' }}"
msgstr ""
"إشعار: تم رفض المادة التسويقية {{ object.name }} ({{ object.code or '' }})"
" من قبل {{ 'إدارة الفرص' if (ctx.get('is_opportunity') or "
"object.is_opportunity_request or (object.marketing_id and "
"(object.marketing_id.is_opportunity_request or "
"object.marketing_id.opportunity_id))) else 'مدير المشروع' }}"

#. module: marketing_opportunity_management
#: model:mail.template,body_html:marketing_opportunity_management.email_template_marketing_material_rejected_by_pm
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" dir=\"ltr\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px; text-align: left;\">\n"
"                        Sender: <strong>Marketing Department - Bussma</strong><br/><br/>\n"
"                        Dear <strong>Marketing Supervisors</strong>,<br/><br/>\n"
"                        <t t-set=\"is_opp\" t-value=\"ctx.get('is_opportunity') or object.is_opportunity_request or (object.marketing_id and (object.marketing_id.is_opportunity_request or object.marketing_id.opportunity_id))\"/>\n"
"                        Marketing material \"<strong><t t-out=\"object.name\"/></strong>\" (Code: <strong><t t-out=\"object.code or 'N/A'\"/></strong>) has been <strong>rejected</strong> by the <t t-out=\"'Opportunity Department' if is_opp else 'Project Manager'\"/> and returned to the Marketing Supervisor Approval stage.<br/><br/>\n"
"                        <strong>Rejection Details:</strong>\n"
"                        </p><ul>\n"
"                            <li><strong>Material Name:</strong> <t t-out=\"object.name\"/></li>\n"
"                            <li><strong>Marketing Project Name:</strong> <t t-out=\"object.marketing_id.name or '-'\"/></li>\n"
"                            <li><strong>Responsible User:</strong> <t t-out=\"object.user_id.name or '-'\"/></li>\n"
"                            <li><strong><t t-out=\"'Opportunity Department Return Notes:' if is_opp else 'Project Manager Return Notes:'\"/></strong>\n"
"                                <div style=\"background-color: #f8f9fa; padding: 10px; border-left: 4px solid #dc3545; margin-top: 5px;\">\n"
"                                    <t t-out=\"object.pm_rejection_notes or 'No rejection notes provided'\"/>\n"
"                                </div>\n"
"                            </li>\n"
"                        </ul>\n"
"                        Please log in to the system to review the material and take the necessary action.\n"
"                    \n"
"                    <div style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                        <a t-att-href=\"'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (object.get_base_url(), object.id, object._name)\" style=\"background-color: #dc3545; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;\">\n"
"                            View Marketing Material\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" dir=\"rtl\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px; text-align: right;\">\n"
"                        المرسل: <strong>قسم التسويق - بصمة</strong><br/><br/>\n"
"                        أعضاء <strong>إشراف التسويق</strong> المحترمين،<br/><br/>\n"
"                        <t t-set=\"is_opp\" t-value=\"ctx.get('is_opportunity') or object.is_opportunity_request or (object.marketing_id and (object.marketing_id.is_opportunity_request or object.marketing_id.opportunity_id))\"/>\n"
"                        تم <strong>رفض</strong> المادة التسويقية \"<strong><t t-out=\"object.name\"/></strong>\" (كود النشاط: <strong><t t-out=\"object.code or 'N/A'\"/></strong>) من قبل <t t-out=\"'إدارة الفرص' if is_opp else 'مدير المشروع'\"/> وإعادتها لمرحلة اعتماد مشرف التسويق.<br/><br/>\n"
"                        <strong>تفاصيل الرفض:</strong>\n"
"                        </p><ul>\n"
"                            <li><strong>اسم المادة:</strong> <t t-out=\"object.name\"/></li>\n"
"                            <li><strong>اسم المشروع التسويقي:</strong> <t t-out=\"object.marketing_id.name or '-'\"/></li>\n"
"                            <li><strong>المستخدم المسؤول:</strong> <t t-out=\"object.user_id.name or '-'\"/></li>\n"
"                            <li><strong><t t-out=\"'ملاحظات الإرجاع من إدارة الفرص:' if is_opp else 'ملاحظات الإرجاع من مدير المشروع:'\"/></strong>\n"
"                                <div style=\"background-color: #f8f9fa; padding: 10px; border-right: 4px solid #dc3545; margin-top: 5px;\">\n"
"                                    <t t-out=\"object.pm_rejection_notes or 'لا يوجد ملاحظات إرجاع'\"/>\n"
"                                </div>\n"
"                            </li>\n"
"                        </ul>\n"
"                        نرجو الدخول للنظام والاطلاع على المادة ومراجعة الملاحظات واتخاذ الإجراء المناسب.\n"
"                    \n"
"                    <div style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                        <a t-att-href=\"'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (object.get_base_url(), object.id, object._name)\" style=\"background-color: #dc3545; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;\">\n"
"                            رابط المادة التسويقية\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "


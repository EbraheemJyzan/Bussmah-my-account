#. module: marketing_opportunity_management
#: model:mail.template,body_html:marketing_opportunity_management.email_template_entry_requires_technical_offer
msgid ""
"<div style=\"margin: 0px; padding: 20px; font-family: 'Segoe UI', Helvetica, Arial, sans-serif; background-color: #f8f9fa; color: #333333;\">\n"
"                    <div style=\"max-width: 650px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 1px solid #e9ecef;\">\n"
"                        <!-- Header -->\n"
"                        <div style=\"background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); padding: 24px 30px; text-align: left;\">\n"
"                            <h2 style=\"color: #ffffff; margin: 0; font-size: 20px; font-weight: 600;\">Opportunity Department Notification</h2>\n"
"                        </div>\n"
"                        <!-- Content -->\n"
"                        <div style=\"padding: 30px;\">\n"
"                            <p style=\"font-size: 15px; line-height: 1.6; margin-top: 0; color: #212529;\">\n"
"                                Dear Opportunity Department Team,\n"
"                            </p>\n"
"                            <p style=\"font-size: 14px; line-height: 1.6; color: #495057;\">\n"
"                                Please be informed that a property in the <strong>Studies</strong> phase has been marked as requiring a <strong>Technical Offer</strong>.\n"
"                            </p>\n"
"                            \n"
"                            <!-- Details Box -->\n"
"                            <div style=\"background-color: #f1f5f9; border-left: 4px solid #2a5298; border-radius: 4px; padding: 16px 20px; margin: 20px 0;\">\n"
"                                <table style=\"width: 100%; border-collapse: collapse; font-size: 13px;\">\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d; width: 38%;\"><strong>Property Name:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529; font-weight: 600;\"><t t-out=\"object.entrie_name or 'N/A'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>Client Name:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.partner_id.name or '-'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>Current Stage:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.stage_id.name or 'Studies'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>Property Type:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.property_type.name if object.property_type else '-'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>City / District:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\">\n"
"                                            <t t-out=\"object.city.name if object.city else '-'\"/> / <t t-out=\"object.district_id.name if object.district_id else '-'\"/>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>Area (sqm):</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.area_sqm or '-'\"/> m²</td>\n"
"                                    </tr>\n"
"                                    <t t-if=\"object.location_url\">\n"
"                                        <tr>\n"
"                                            <td style=\"padding: 6px 0; color: #6c757d;\"><strong>Location:</strong></td>\n"
"                                            <td style=\"padding: 6px 0;\">\n"
"                                                <a t-att-href=\"object.location_url\" target=\"_blank\" style=\"color: #2a5298; text-decoration: underline;\">View Location on Map</a>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </t>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>Entered By:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.entered_by_id.name or object.create_uid.name or '-'\"/></td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </div>\n"
"\n"
"                            <p style=\"font-size: 13px; color: #6c757d; margin: 20px 0;\">\n"
"                                Kindly review the property details and proceed with the necessary technical preparation.\n"
"                            </p>\n"
"\n"
"                            <!-- CTA Button -->\n"
"                            <div style=\"margin: 25px 0 15px 0; text-align: center;\">\n"
"                                <a t-att-href=\"'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (object.get_base_url(), object.id, object._name)\" style=\"background: #2a5298; color: #ffffff; padding: 12px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; display: inline-block;\">\n"
"                                    View Property Details\n"
"                                </a>\n"
"                            </div>\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div dir=\"rtl\" style=\"margin: 0px; padding: 20px; font-family: 'Segoe UI', Tahoma, Arial, sans-serif; background-color: #f8f9fa; color: #333333; text-align: right;\">\n"
"                    <div style=\"max-width: 650px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 1px solid #e9ecef;\">\n"
"                        <!-- Header -->\n"
"                        <div style=\"background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); padding: 24px 30px; text-align: right;\">\n"
"                            <h2 style=\"color: #ffffff; margin: 0; font-size: 20px; font-weight: 600;\">إشعار إدارة الفرص</h2>\n"
"                        </div>\n"
"                        <!-- Content -->\n"
"                        <div style=\"padding: 30px; text-align: right;\">\n"
"                            <p style=\"font-size: 15px; line-height: 1.6; margin-top: 0; color: #212529;\">\n"
"                                فريق قسم إدارة الفرص المحترمون،\n"
"                            </p>\n"
"                            <p style=\"font-size: 14px; line-height: 1.6; color: #495057;\">\n"
"                                نود إحاطتكم بأنه تم تحديد عقار في مرحلة <strong>الدراسات</strong> يتطلب <strong>عرضاً فنياً</strong>.\n"
"                            </p>\n"
"                            \n"
"                            <!-- Details Box -->\n"
"                            <div style=\"background-color: #f1f5f9; border-right: 4px solid #2a5298; border-radius: 4px; padding: 16px 20px; margin: 20px 0;\">\n"
"                                <table style=\"width: 100%; border-collapse: collapse; font-size: 13px; text-align: right;\">\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d; width: 38%;\"><strong>اسم العقار:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529; font-weight: 600;\"><t t-out=\"object.entrie_name or 'N/A'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>اسم العميل:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.partner_id.name or '-'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>المرحلة الحالية:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.stage_id.name or 'الدراسات'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>نوع العقار:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.property_type.name if object.property_type else '-'\"/></td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>المدينة / الحي:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\">\n"
"                                            <t t-out=\"object.city.name if object.city else '-'\"/> / <t t-out=\"object.district_id.name if object.district_id else '-'\"/>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>المساحة (م²):</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.area_sqm or '-'\"/> م²</td>\n"
"                                    </tr>\n"
"                                    <t t-if=\"object.location_url\">\n"
"                                        <tr>\n"
"                                            <td style=\"padding: 6px 0; color: #6c757d;\"><strong>الموقع:</strong></td>\n"
"                                            <td style=\"padding: 6px 0;\">\n"
"                                                <a t-att-href=\"object.location_url\" target=\"_blank\" style=\"color: #2a5298; text-decoration: underline;\">عرض الموقع على الخريطة</a>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </t>\n"
"                                    <tr>\n"
"                                        <td style=\"padding: 6px 0; color: #6c757d;\"><strong>تم إدراجه بواسطة:</strong></td>\n"
"                                        <td style=\"padding: 6px 0; color: #212529;\"><t t-out=\"object.entered_by_id.name or object.create_uid.name or '-'\"/></td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </div>\n"
"\n"
"                            <p style=\"font-size: 13px; color: #6c757d; margin: 20px 0;\">\n"
"                                يرجى مراجعة تفاصيل العقار والمباشرة بإعداد العرض الفني المطلوب.\n"
"                            </p>\n"
"\n"
"                            <!-- CTA Button -->\n"
"                            <div style=\"margin: 25px 0 15px 0; text-align: center;\">\n"
"                                <a t-att-href=\"'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (object.get_base_url(), object.id, object._name)\" style=\"background: #2a5298; color: #ffffff; padding: 12px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; display: inline-block;\">\n"
"                                    عرض تفاصيل العقار\n"
"                                </a>\n"
"                            </div>\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"            "


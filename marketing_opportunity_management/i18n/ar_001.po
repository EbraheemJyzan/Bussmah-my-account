#. module: marketing_opportunity_management
#: model:mail.template,body_html:marketing_opportunity_management.email_template_opportunity_user_replaced
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" dir=\"ltr\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px; text-align: left;\">\n"
"                        Sender: <strong>Opportunity Management System - Bussma</strong><br/><br/>\n"
"                        Dear <strong><t t-out=\"ctx.get('old_user_name') or 'User'\"/></strong>,<br/><br/>\n"
"                        Please be informed that you have been replaced as the <strong>Contact Officer</strong> for Opportunity No. <strong><t t-out=\"object.code or 'N/A'\"/></strong> (Opportunity Name: <strong><t t-out=\"object.name\"/></strong>), and the responsibility has been reassigned to <strong><t t-out=\"object.assigned_user_id.name or 'another officer'\"/></strong>.<br/><br/>\n"
"                        <strong>Opportunity Details:</strong>\n"
"                        </p><ul>\n"
"                            <li><strong>Opportunity Code:</strong> <t t-out=\"object.code or 'N/A'\"/></li>\n"
"                            <li><strong>Opportunity Name:</strong> <t t-out=\"object.name or '-'\"/></li>\n"
"                            <li><strong>Client:</strong> <t t-out=\"object.partner_id.name or '-'\"/></li>\n"
"                            <li><strong>New Contact Officer:</strong> <t t-out=\"object.assigned_user_id.name or '-'\"/></li>\n"
"                            <li><strong>Current Stage:</strong> <t t-out=\"object.stage_id.name or '-'\"/></li>\n"
"                        </ul>\n"
"                        We sincerely appreciate your previous efforts and dedication in following up on this opportunity.\n"
"                    \n"
"                    <div style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                        <a t-att-href=\"'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (object.get_base_url(), object.id, object._name)\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;\">\n"
"                            View Opportunity\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" dir=\"rtl\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px; text-align: right;\">\n"
"                        المرسل: <strong>نظام إدارة الفرص - بصمة</strong><br/><br/>\n"
"                        عزيزي / <strong><t t-out=\"ctx.get('old_user_name') or 'المستخدم'\"/></strong>،<br/><br/>\n"
"                        نحيطكم علماً بأنه قد تم استبدالكم كـ <strong>ضابط اتصال</strong> للفرصة رقم <strong><t t-out=\"object.code or 'N/A'\"/></strong> (اسم الفرصة: <strong><t t-out=\"object.name\"/></strong>)، وتمت إعادة إسناد المسؤولية إلى <strong><t t-out=\"object.assigned_user_id.name or 'ضابط اتصال آخر'\"/></strong>.<br/><br/>\n"
"                        <strong>تفاصيل الفرصة:</strong>\n"
"                        </p><ul>\n"
"                            <li><strong>كود الفرصة:</strong> <t t-out=\"object.code or 'N/A'\"/></li>\n"
"                            <li><strong>اسم الفرصة:</strong> <t t-out=\"object.name or '-'\"/></li>\n"
"                            <li><strong>العميل:</strong> <t t-out=\"object.partner_id.name or '-'\"/></li>\n"
"                            <li><strong>ضابط الاتصال الجديد:</strong> <t t-out=\"object.assigned_user_id.name or '-'\"/></li>\n"
"                            <li><strong>المرحلة الحالية:</strong> <t t-out=\"object.stage_id.name or '-'\"/></li>\n"
"                        </ul>\n"
"                        شاكرين ومقدرين لكم جهودكم وتفانيكم السابق في متابعة هذه الفرصة.\n"
"                    \n"
"                    <div style=\"margin: 16px 0px 16px 0px; text-align: center;\">\n"
"                        <a t-att-href=\"'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (object.get_base_url(), object.id, object._name)\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;\">\n"
"                            عرض الفرصة\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Request Type for Marketing -->
        <record id="request_type_marketing" model="request.type">
            <field name="name">Marketing</field>
            <field name="res_model">bussma.marketing</field>
            <field name="res_model_id" ref="model_bussma_marketing"/>
        </record>

        <!-- Marketing Stages (request.stage) -->
        <record id="stage_marketing_draft" model="request.stage">
            <field name="name">Request Received</field>
            <field name="res_model">bussma.marketing</field>
            <field name="res_model_id" ref="model_bussma_marketing"/>
            <field name="sequence">1</field>
            <field name="state">draft</field>
            <field name="marketing_stage_selection">mkt_draft</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_marketing')])]"/>
        </record>

        <record id="stage_marketing_review" model="request.stage">
            <field name="name">Review and Classification</field>
            <field name="res_model">bussma.marketing</field>
            <field name="res_model_id" ref="model_bussma_marketing"/>
            <field name="sequence">2</field>
            <field name="state">in_progress</field>
            <field name="marketing_stage_selection">mkt_review</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_marketing')])]"/>
        </record>

        <record id="stage_marketing_supervisor_approval" model="request.stage">
            <field name="name">Marketing Supervisor Approval</field>
            <field name="res_model">bussma.marketing</field>
            <field name="res_model_id" ref="model_bussma_marketing"/>
            <field name="sequence">3</field>
            <field name="state">in_progress</field>
            <field name="marketing_stage_selection">mkt_approval</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_marketing')])]"/>
        </record>

        <record id="stage_marketing_done" model="request.stage">
            <field name="name">Completed</field>
            <field name="res_model">bussma.marketing</field>
            <field name="res_model_id" ref="model_bussma_marketing"/>
            <field name="sequence">4</field>
            <field name="state">done</field>
            <field name="marketing_stage_selection">mkt_done</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_marketing')])]"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Request Type for Opportunity -->
        <record id="request_type_opportunity" model="request.type">
            <field name="name">Opportunity</field>
            <field name="res_model">bussma.opportunity</field>
            <field name="res_model_id" ref="model_bussma_opportunity"/>
        </record>

        <!-- Opportunity Stages (request.stage) -->
        <record id="stage_opportunity_draft" model="request.stage">
            <field name="name">Draft</field>
            <field name="res_model">bussma.opportunity</field>
            <field name="res_model_id" ref="model_bussma_opportunity"/>
            <field name="sequence">1</field>
            <field name="state">draft</field>
            <field name="opportunity_stage_selection">opp_draft</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_opportunity')])]"/>
            
        </record>

        <record id="stage_opportunity_data_completion" model="request.stage">
            <field name="name">Data Completion</field>
            <field name="res_model">bussma.opportunity</field>
            <field name="res_model_id" ref="model_bussma_opportunity"/>
            <field name="sequence">2</field>
            <field name="state">in_progress</field>
            <field name="opportunity_stage_selection">opp_data_completion</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_opportunity')])]"/>
        </record>

        <record id="stage_opportunity_marketing_request" model="request.stage">
            <field name="name">Marketing Request</field>
            <field name="res_model">bussma.opportunity</field>
            <field name="res_model_id" ref="model_bussma_opportunity"/>
            <field name="sequence">3</field>
            <field name="state">in_progress</field>
            <field name="opportunity_stage_selection">opp_marketing_request</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_opportunity')])]"/>
        </record>

        <record id="stage_opportunity_final_material" model="request.stage">
            <field name="name">Final Material Receipt</field>
            <field name="res_model">bussma.opportunity</field>
            <field name="res_model_id" ref="model_bussma_opportunity"/>
            <field name="sequence">4</field>
            <field name="state">in_progress</field>
            <field name="opportunity_stage_selection">opp_final_material</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_opportunity')])]"/>
        </record>

        <record id="stage_opportunity_approve_close" model="request.stage">
            <field name="name">Approve Opportunity Closure</field>
            <field name="res_model">bussma.opportunity</field>
            <field name="res_model_id" ref="model_bussma_opportunity"/>
            <field name="sequence">5</field>
            <field name="state">in_progress</field>
            <field name="opportunity_stage_selection">opp_approve_close</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_opportunity')])]"/>
        </record>

        <record id="stage_opportunity_contracted" model="request.stage">
            <field name="name">Contracted</field>
            <field name="res_model">bussma.opportunity</field>
            <field name="res_model_id" ref="model_bussma_opportunity"/>
            <field name="sequence">6</field>
            <field name="state">done</field>
            <field name="opportunity_stage_selection">opp_contracted</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_opportunity')])]"/>
        </record>
    </data>
</odoo>

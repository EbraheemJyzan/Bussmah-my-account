<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Request Type for Marketing Material -->
        <record id="request_type_marketing_material" model="request.type">
            <field name="name">Marketing Material</field>
            <field name="res_model">bussma.marketing.material</field>
            <field name="res_model_id" ref="model_bussma_marketing_material"/>
        </record>

        <!-- Marketing Material Stages (request.stage) -->
        <record id="stage_mat_content_exec" model="request.stage">
            <field name="name">Content Execution</field>
            <field name="res_model">bussma.marketing.material</field>
            <field name="res_model_id" ref="model_bussma_marketing_material"/>
            <field name="sequence">1</field>
            <field name="state">in_progress</field>
            <field name="material_stage_selection">mat_content_exec</field>
            <field name="department_id" ref="dept_content"/>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_marketing_material')])]"/>
        </record>


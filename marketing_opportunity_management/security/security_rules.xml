<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Record Rule for Opportunity Contact Officer (Assigned Opportunities Only) -->
        <record id="rule_bussma_opportunity_officer" model="ir.rule">
            <field name="name">Opportunity: Contact Officer (Assigned Only)</field>
            <field name="model_id" ref="model_bussma_opportunity"/>
            <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('marketing_opportunity_management.group_opportunity_contact_officer'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule for Opportunity Manager (All Opportunities) -->
        <record id="rule_bussma_opportunity_manager" model="ir.rule">
            <field name="name">Opportunity: Manager (All Opportunities)</field>
            <field name="model_id" ref="model_bussma_opportunity"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('marketing_opportunity_management.group_opportunity_management'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
        <!-- Record Rule for Marketing User / Responsible / Material User / Requester / Opportunity Officer -->
        <record id="rule_bussma_marketing_user" model="ir.rule">
            <field name="name">Marketing: Responsible or Material Responsible User</field>
            <field name="model_id" ref="model_bussma_marketing"/>
            <field name="domain_force">['|', '|', '|', '|', '|', ('requested_by_id', '=', user.id), ('material_responsible_id', '=', user.id), ('material_ids.user_id', '=', user.id), ('material_ids.department_ids.manager_id', '=', user.id), ('material_ids.department_ids.member_ids', 'in', [user.id]), ('opportunity_id.assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule for Opportunity Management (Marketing Records Linked to Opportunity) -->
        <record id="rule_bussma_marketing_opportunity_management" model="ir.rule">
            <field name="name">Marketing: Opportunity Management (Linked to Opportunity)</field>
            <field name="model_id" ref="model_bussma_marketing"/>
            <field name="domain_force">[('opportunity_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('marketing_opportunity_management.group_opportunity_management'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule for Sales Manager (Marketing Records Linked to Sales Projects) -->
        <record id="rule_bussma_marketing_sales_manager" model="ir.rule">
            <field name="name">Marketing: Sales Manager (Sales Projects)</field>
            <field name="model_id" ref="model_bussma_marketing"/>
            <field name="domain_force">[('bussma_project_id.project_type', '=', 'sales')]</field>
            <field name="groups" eval="[(4, ref('bussma_system.group_sales_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule for Auctions Manager (Marketing Records Linked to Auction Projects) -->
        <record id="rule_bussma_marketing_auctions_manager" model="ir.rule">
            <field name="name">Marketing: Auctions Manager (Auction Projects)</field>
            <field name="model_id" ref="model_bussma_marketing"/>
            <field name="domain_force">[('bussma_project_id.project_type', 'in', ['auction_pvt', 'auction_enf', 'city'])]</field>
            <field name="groups" eval="[(4, ref('bussma_system.group_auctions_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule for Project Manager (Marketing Records Linked to Managed Projects) -->
        <record id="rule_bussma_marketing_project_manager" model="ir.rule">
            <field name="name">Marketing: Project Manager (Managed Projects)</field>
            <field name="model_id" ref="model_bussma_marketing"/>
            <field name="domain_force">[('bussma_project_id.project_manager_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('sales_and_auction_management.group_sales_project_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule for Marketing Supervisor (All Marketing Records) -->
        <record id="rule_bussma_marketing_supervisor" model="ir.rule">
            <field name="name">Marketing: Supervisor (All Records)</field>
            <field name="model_id" ref="model_bussma_marketing"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('marketing_opportunity_management.group_marketing_supervisor'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rule for Marketing Supervisor on Opportunities (Linked to Marketing Request) -->
        <record id="rule_bussma_opportunity_marketing_supervisor" model="ir.rule">
            <field name="name">Opportunity: Marketing Supervisor (Linked to Marketing Request)</field>
            <field name="model_id" ref="model_bussma_opportunity"/>
            <field name="domain_force">[('marketing_id', '!=', False)]</field>
            <field name="groups" eval="[(4, ref('marketing_opportunity_management.group_marketing_supervisor'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule for Marketing Tasks (Assigned Users, Material Dept Members/Managers, Responsible, Project PM) -->
        <record id="rule_bussma_marketing_task_user" model="ir.rule">
            <field name="name">Marketing Task: Assigned Users and Department Members</field>
            <field name="model_id" ref="model_bussma_marketing_task"/>
            <field name="domain_force">['|', '|', '|', '|', '|', '|', '|', '|',
                ('user_ids', 'in', [user.id]),
                ('department_id.member_ids', 'in', [user.id]),
                ('department_id.manager_id', '=', user.id),
                ('material_id.department_ids.member_ids', 'in', [user.id]),
                ('material_id.department_ids.manager_id', '=', user.id),
                ('material_id.user_id', '=', user.id),
                ('marketing_id.material_responsible_id', '=', user.id),
                ('marketing_id.requested_by_id', '=', user.id),
                ('marketing_id.bussma_project_id.project_manager_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rule for Marketing Task Supervisor (All Tasks) -->
        <record id="rule_bussma_marketing_task_supervisor" model="ir.rule">
            <field name="name">Marketing Task: Supervisor (All Tasks)</field>
            <field name="model_id" ref="model_bussma_marketing_task"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('marketing_opportunity_management.group_marketing_supervisor'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rule for Office Requests (Personal or Requested By) -->
        <record id="rule_office_request_user" model="ir.rule">
            <field name="name">Office Request: Personal or Requested By</field>
            <field name="model_id" ref="model_office_request"/>
            <field name="domain_force">['|', ('create_uid', '=', user.id), ('requested_by_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rule for Office Requests (Managers and System Admins - All Requests) -->
        <record id="rule_office_request_manager" model="ir.rule">
            <field name="name">Office Request: Managers and System Admins (All Requests)</field>
            <field name="model_id" ref="model_office_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (4, ref('bussma_system.group_commercial_sector_manager')),
                (4, ref('sales_and_auction_management.group_system_admin')),
                (4, ref('base.group_system')),
                (4, ref('marketing_opportunity_management.group_marketing_supervisor'))
            ]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>

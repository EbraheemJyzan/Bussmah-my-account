<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_office_department_form" model="ir.ui.view">
            <field name="name">office.department.form</field>
            <field name="model">office.department</field>
            <field name="arch" type="xml">
                <form string="Office Department">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Department Name..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="Description">
                            <field name="description" placeholder="Department description..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_office_department_tree" model="ir.ui.view">
            <field name="name">office.department.list</field>
            <field name="model">office.department</field>
            <field name="arch" type="xml">
                <list string="Office Departments">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_office_department" model="ir.actions.act_window">
            <field name="name">Office Departments</field>
            <field name="res_model">office.department</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View for bussma.marketing.task -->
        <record id="view_bussma_marketing_task_form" model="ir.ui.view">
            <field name="name">bussma.marketing.task.form</field>
            <field name="model">bussma.marketing.task</field>
            <field name="arch" type="xml">
                <form string="Marketing Tasks">
                    <header>
                        <field name="is_authorized_supervisor" invisible="1"/>
                        <field name="is_task_assignee" invisible="1"/>
                        <field name="is_marketing_supervisor" invisible="1"/>
                        <field name="state" widget="statusbar" options="{'clickable': '1'}" readonly="(state in ('approved', 'cancel') and not is_authorized_supervisor) or (state not in ('approved', 'cancel') and not (is_task_assignee or is_authorized_supervisor))"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" readonly="state in ('approved', 'cancel') or not (is_task_editor or is_authorized_supervisor)" placeholder="Task Title..."/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="material_id" readonly="1" options="{'no_open': True}"/>
                                <field name="marketing_id" readonly="1" options="{'no_open': True}"/>
                                <field name="allowed_department_ids" invisible="1"/>
                                <field name="department_id" domain="[('id', 'in', allowed_department_ids)]" readonly="state in ('approved', 'cancel') or not (is_task_editor or is_authorized_supervisor)" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group>
                                <field name="department_member_ids" invisible="1"/>
                                <field name="user_ids" widget="many2many_tags" readonly="state in ('approved', 'cancel') or not (is_task_editor or is_authorized_supervisor)" options="{'no_create_edit': True, 'no_open': True}"/>
                                <field name="date_deadline" readonly="state in ('approved', 'cancel') or not (is_task_editor or is_authorized_supervisor)"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Request">
                                <group>
                                    <field name="request_notes" readonly="state in ('approved', 'cancel') or not is_authorized_supervisor"/>
                                    <field name="request_attachment_ids" widget="many2many_binary" readonly="state in ('approved', 'cancel') or not is_authorized_supervisor"/>
                                </group>
                            </page>
                            <page string="Result">
                                <group>
                                    <field name="is_task_assignee" invisible="1"/>
                                    <field name="result_notes" readonly="state in ('approved', 'cancel') or not is_task_assignee"/>
                                    <field name="result_attachment_ids" widget="many2many_binary" readonly="state in ('approved', 'cancel') or not is_task_assignee"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- List View for bussma.marketing.task -->
        <record id="view_bussma_marketing_task_tree" model="ir.ui.view">
            <field name="name">bussma.marketing.task.tree</field>
            <field name="model">bussma.marketing.task</field>
            <field name="arch" type="xml">
                <list string="Marketing Tasks">
                    <field name="name"/>
                    <field name="material_id"/>
                    <field name="marketing_id"/>
                    <field name="department_id"/>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="date_deadline"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- Kanban View for bussma.marketing.task -->
        <record id="view_bussma_marketing_task_kanban" model="ir.ui.view">
            <field name="name">bussma.marketing.task.kanban</field>
            <field name="model">bussma.marketing.task</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                    <field name="name"/>
                    <field name="material_id"/>
                    <field name="marketing_id"/>
                    <field name="department_id"/>
                    <field name="user_ids"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                            </div>
                            <div class="text-muted small mb-1">
                                <t t-if="record.material_id.raw_value">
                                    <i class="fa fa-folder-o me-1"/> <field name="material_id"/><br/>
                                </t>
                                <t t-if="record.user_ids.raw_value">
                                    <i class="fa fa-user me-1"/> <field name="user_ids" widget="many2many_tags"/>
                                </t>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <field name="department_id"/>
                                <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'in_progress': 'secondary', 'done': 'warning', 'approved': 'success', 'cancel': 'danger'}}"/>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View for bussma.marketing.task -->
        <record id="view_bussma_marketing_task_search" model="ir.ui.view">
            <field name="name">bussma.marketing.task.search</field>
            <field name="model">bussma.marketing.task</field>
            <field name="arch" type="xml">
                <search string="Search Marketing Tasks">
                    <field name="name"/>
                    <field name="material_id"/>
                    <field name="marketing_id"/>
                    <field name="user_ids"/>
                    <group expand="0" string="Group By">
                        <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Marketing Material" name="group_by_material" context="{'group_by': 'material_id'}"/>
                        <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <sheet>
                    <header>
                        <button name="action_set_in_progress"
                                type="object"
                                string="Start"
                                class="btn-primary"
                                groups="helpdesk_ticket.group_helpdesk_manager"
                                invisible="state != 'new'"/>

                        <button name="action_set_solved"
                                type="object"
                                string="Solve"
                                class="btn-success"
                                groups="helpdesk_ticket.group_helpdesk_manager"
                                invisible="state not in ['in_progress']"/>

                        <button name="action_set_closed"
                                type="object"
                                string="Close"
                                class="btn-danger"
                                groups="helpdesk_ticket.group_helpdesk_manager"
                                invisible="state in ['solved', 'closed']"/>

                        <button name="action_reset_to_new"
                                type="object"
                                string="Reset"
                                class="btn-secondary"
                                groups="helpdesk_ticket.group_helpdesk_manager"
                                invisible="state != 'closed'"/>

                        <field name="state" widget="statusbar"
                               statusbar_visible="new,in_progress,solved,closed"/>
                    </header>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="priority" readonly="state in ['solved', 'closed']"/>
                        <field name="subject" readonly="state in ['solved', 'closed']"/>
                        <field name="user_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" readonly="state in ['solved', 'closed']"/>
                        </page>
                    </notebook>
                </sheet>
                <!--                ajoute le chatter dans le formulaire-->
                 <chatter />
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_tree" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="Tickets">
                <field name="name"/>
                <field name="subject"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="priority"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state" records_draggable="false" sample="1">
                <field name="state"/>
                <field name="color"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <!-- State Indicator: Thin Color Side Bar -->
                        <div t-attf-class="position-absolute top-0 start-0 h-100 #{record.state.raw_value == 'new' ? 'bg-secondary' : record.state.raw_value == 'in_progress' ? 'bg-warning' : record.state.raw_value == 'solved' ? 'bg-success' : record.state.raw_value == 'closed' ? 'bg-danger' : 'bg-secondary'}" style="width: 4px; border-top-left-radius: 3px; border-bottom-left-radius: 3px; z-index: 1;"/>
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_global_click ps-2">
                            <!-- Optional color picker dropdown -->
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <ul class="oe_kanban_colorpicker" data-field="color"/>
                                </div>
                            </div>
                            
                            <!-- Header: Reference and Priority -->
                            <div class="o_kanban_record_top mb-1">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <field name="priority" widget="priority"/>
                                </div>
                            </div>
                            
                            <!-- Body: Subject -->
                            <div class="o_kanban_record_body mb-3">
                                <div class="text-muted" t-if="record.subject.raw_value">
                                    <field name="subject"/>
                                </div>
                            </div>

                            <!-- Footer: Customer Avatar -->
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <!-- Add left items here if needed (e.g. Activity Widget) -->
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>

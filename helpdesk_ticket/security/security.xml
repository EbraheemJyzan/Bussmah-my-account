<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Categories -->
        <record id="module_category_helpdesk_ticket" model="ir.module.category">
            <field name="name">Helpdesk</field>
            <field name="description">Helps you manage your helpdesk tickets.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groups -->
        <record id="group_helpdesk_user" model="res.groups">
            <field name="name">Helpdesk User</field>
            <field name="category_id" ref="module_category_helpdesk_ticket"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will be able to manage their own tickets.</field>
        </record>

        <record id="group_helpdesk_manager" model="res.groups">
            <field name="name">Helpdesk Manager</field>
            <field name="category_id" ref="module_category_helpdesk_ticket"/>
            <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="comment">The user will have access to all tickets and configuration.</field>
        </record>
        
        <!-- Record Rules -->
        <record id="rule_helpdesk_ticket_user" model="ir.rule">
            <field name="name">Helpdesk Ticket: User</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_helpdesk_ticket_manager" model="ir.rule">
            <field name="name">Helpdesk Ticket: Manager</field>
            <field name="model_id" ref="model_helpdesk_ticket"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_helpdesk_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>

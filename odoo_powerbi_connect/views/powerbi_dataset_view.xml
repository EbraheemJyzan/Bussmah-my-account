<odoo>
    <data>

        <record id="powerbi_dataset_view_form" model="ir.ui.view">
            <field name="name">powerbi.dataset.view.form</field>
            <field name="model">powerbi.dataset</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Power BI Dataset">
                    <header>
                        <button name="action_publish"
                            type="object"
                            string="Publish"
                            class="btn btn-primary"
                            confirm="Upon publish a new dataset will be created on Power BI end along with the associated tables."
                            invisible="state == 'published' or dataset_type == 'import'" />
                        <button name="action_unpublish"
                            type="object"
                            string="UnPublish"
                            class="btn btn-danger"
                            invisible="state != 'published' or dataset_type == 'import'" />
                        <button name="action_set_publish"
                            type="object"
                            string="Set Published"
                            class="btn btn-primary"
                            invisible="state == 'published' or dataset_type == 'push'" />
                        <button name="action_set_unpublish"
                            type="object"
                            string="Set UnPublish"
                            class="btn btn-danger"
                            invisible="state != 'published' or dataset_type == 'push'" />

                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box" invisible="not id">
                            <button name="action_redirect" type="object" class="oe_stat_button"
                                context="{'model_name':'powerbi.table','name':'Tables'}"
                                icon="fa-list-ul">
                                <field name="count_total_table" widget="statinfo" string="Tables" />
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="is_published" invisible='1' />
                                <field name="name"
                                    readonly="state == 'published'" />
                                <field name="powerbi_id" invisible="is_published == False" />
                                <field name="workspace_id"
                                    readonly="state == 'published'" />
                                <field name="dataset_type" readonly="is_published == True" />
                                <field name="table_ids"
                                    invisible="count_total_table == 0"
                                    widget="many2many_tags" />
                            </group>
                            <group>
                                <field name="create_uid" readonly="1" />
                                <field name="create_date" readonly="1" />
                                <field name="write_date" />
                            </group>
                        </group>
                        <group invisible="dataset_type == 'push'">
                            <group string="Web details">
                                <field name="web_auth" required="dataset_type == 'import'" />
                                <field name="web_url" widget="CopyClipboardChar" />
                                <div></div>
                                <div class="alert alert-primary">
                                    By default, page number 1 will be used. You can pass a different page number in the URL by using the keyword 'page'.
                                </div>
                                <label for="web_token" string="Web Token"
                                    invisible="web_auth == 'api_key'" />
                                <div class="o_row" invisible="web_auth == 'api_key'">
                                    <field name="web_token" invisible="not web_token"
                                        required="web_auth == 'web_token'" />
                                    <button name="action_generate_web_token" type="object"
                                        string="Generate New" class="btn-link px-0"
                                        icon="fa-refresh" />
                                </div>
                                <field name="show_steps" />
                            </group>
                            <group string="">
                                <div class="alert alert-info"
                                    invisible="web_auth != 'api_key'">
                                    <div class="text-muted">
                                        You must send the Authorization header in the request else
                                        the request will fail.
                                    </div>
                                </div>
                            </group>
                        </group>
                        <group string="Steps to use web url"
                            invisible="dataset_type != 'import' or show_steps == False">
                            <div invisible="not show_steps">
                                <div class="d-inline-flex text-center gap-2 alert alert-primary">
                                    <div>Open PowerBI</div>
                                    <div>
                                        <i class="fa fa-long-arrow-right " />
                                    </div>
                                    <div>Go to Get Data</div>
                                    <div>
                                        <i class="fa fa-long-arrow-right " />
                                    </div>
                                    <div>Click Web option</div>
                                    <div>
                                        <i class="fa fa-long-arrow-right " />
                                    </div>
                                    <div invisible="web_auth != 'api_key'">
                                        Select Advance
                                    </div>
                                    <div invisible="web_auth != 'api_key'">
                                        <i class="fa fa-long-arrow-right " />
                                    </div>
                                    <div>Enter the URL</div>
                                    <div>
                                        <i class="fa fa-long-arrow-right " />
                                    </div>
                                    <div invisible="web_auth != 'api_key'">
                                        Enter HTTP Request Header Key Pair
                                    </div>
                                    <div invisible="web_auth != 'api_key'">
                                        <i class="fa fa-long-arrow-right " />
                                    </div>
                                    <div>Click OK</div>
                                </div>
                            </div>
                        </group>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <record id="powerbi_dataset_view_tree" model="ir.ui.view">
            <field name="name">powerbi.dataset.view.tree</field>
            <field name="model">powerbi.dataset</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Power BI Dataset">
                    <field name="name" />
                    <field name="dataset_type" />
                    <field name="state"
                        decoration-success="state == 'published'"
                        decoration-info="state == 'topublish'"
                        widget="badge" optional="show" />
                    <field name="workspace_id" />
                    <field name="create_date" />
                    <field name="create_uid" widget="many2one_avatar_user" />
                </list>
            </field>
        </record>

        <record id="powerbi_dataset_view_search" model="ir.ui.view">
            <field name="name">powerbi.dataset.view.search</field>
            <field name="model">powerbi.dataset</field>
            <field name="arch" type="xml">
                <search>
                    <filter string="Published" name="publish" domain="[('is_published','=',True)]" />
                    <filter string="To Publish" name="topublish"
                        domain="[('is_published','=',False)]" />
                    <group expand="0" string="Group By">
                        <filter string="Workspace" name="group_by_workspace"
                            context="{'group_by':'workspace_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="powerbi_dataset_action_tree" model="ir.actions.act_window">
            <field name="name">Power BI Dataset</field>
            <field name="res_model">powerbi.dataset</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="powerbi_dataset_view_tree" />
        </record>

    </data>
</odoo>

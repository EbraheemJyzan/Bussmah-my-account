<odoo>
    <record id="res_config_settings_view_form_powerbi" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.powerbi</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="5" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="PowerBI" data-string="PowerBI" name="odoo_powerbi_connect"
                    groups="odoo_powerbi_connect.group_powerbi_manager">
                    <block title="Enable Microsoft Fabric" name="catalog_setting_container">
                        <setting id="powerbi_fabric"
                            help="Enable Fabric items (Eventhouse, KQL Database)">
                            <field name="group_powerbi_fabric" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_powerbi_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form_powerbi" />
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'odoo_powerbi_connect', 'bin_size': False}</field>
    </record>

</odoo>
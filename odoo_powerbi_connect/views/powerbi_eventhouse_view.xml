<odoo>
    <data>

        <record id="powerbi_eventhouse_view_form" model="ir.ui.view">
            <field name="name">powerbi.eventhouse.view.form</field>
            <field name="model">powerbi.eventhouse</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Power BI Eventhouse">
                    <header>
                        <button name="action_publish"
                            type="object"
                            string="Publish"
                            class="btn btn-primary"
                            confirm="Upon publish, a new eventhouse will be created on Power BI end, Confirm publish?"
                            invisible="state == 'published'" />

                        <button name="action_unpublish"
                            type="object"
                            string="Unpublish"
                            class="btn btn-danger"
                            invisible="state != 'published'" />

                        <field name="state" widget="statusbar" />

                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box" invisible="not id">
                            <button name="action_redirect" type="object" class="oe_stat_button"
                                context="{'model_name':'powerbi.kql.database','name':'KQL Database'}"
                                icon="fa-list-ul">
                                <field name="count_total_database" widget="statinfo"
                                    string="KQL Database" />
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="is_published" invisible='1' />
                                <field name="name"
                                    readonly="state == 'published'" />
                                <field name="powerbi_id" invisible="is_published == False" />
                                <field name="workspace_id"
                                    readonly="state == 'published'" />
                                <field name="database_ids" invisible="count_total_database == 0"
                                    widget="many2many_tags" />
                            </group>
                            <group>
                                <field name="create_uid" readonly="1" />
                                <field name="create_date" readonly="1" />
                                <field name="write_date" />
                            </group>
                        </group>
                        <group>
                            <group string="Description">
                                <field name="description" colspan="2" nolabel="1" />
                            </group>
                        </group>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <record id="powerbi_eventhouse_view_tree" model="ir.ui.view">
            <field name="name">powerbi.eventhouse.view.tree</field>
            <field name="model">powerbi.eventhouse</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Power BI Eventhouse">
                    <field name="name" />
                    <field name="state"
                        decoration-success="state == 'published'"
                        decoration-info="state == 'topublish'"
                        widget="badge" optional="show" />
                    <field name="workspace_id" />
                    <field name="create_date" />
                    <field name="create_uid" widget="many2one_avatar_user" />
                </list>
            </field>
        </record>

        <record id="powerbi_eventhouse_view_search" model="ir.ui.view">
            <field name="name">powerbi.eventhouse.view.search</field>
            <field name="model">powerbi.eventhouse</field>
            <field name="arch" type="xml">
                <search>
                    <filter string="Published" name="publish" domain="[('is_published','=',True)]" />
                    <filter string="To Publish" name="topublish"
                        domain="[('is_published','=',False)]" />
                    <group expand="0" string="Group By">
                        <filter string="Workspace" name="group_by_workspace"
                            context="{'group_by':'workspace_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="powerbi_eventhouse_action_tree" model="ir.actions.act_window">
            <field name="name">Power BI Eventhouse</field>
            <field name="res_model">powerbi.eventhouse</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="powerbi_eventhouse_view_tree" />
        </record>

    </data>
</odoo>

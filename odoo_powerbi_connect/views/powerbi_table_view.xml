<odoo>
    <data>

        <record id="powerbi_table_view_form" model="ir.ui.view">
            <field name="name">powerbi.table.view.form</field>
            <field name="model">powerbi.table</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Power BI Table">
                    <header invisible="dataset_type != 'push'">
                        <button name="action_publish_table"
                            type="object"
                            string="Publish"
                            class="btn btn-primary"
                            confirm="Do you really want to publish the table to Power BI?"
                            invisible="state == 'published' or not database_id"
                            groups="odoo_powerbi_connect.group_powerbi_fabric" />
                        <button name="action_export"
                            type="object"
                            string="Export Data"
                            class="btn btn-primary"
                            confirm="Do you really want to export the table data to Power BI?"
                            invisible="state != 'published' or is_modified == True" />
                        <button name="action_delete"
                            type="object"
                            string="Delete Data"
                            class="btn btn-warning"
                            confirm="Do you really want to delete all the table data on Power BI?"
                            invisible="state != 'published'" />
                        <button name="action_update_schema"
                            type="object"
                            string="Update Schema"
                            class="btn btn-info"
                            confirm="Do you really want to update the table schema at Power BI? 
Updating schema can cause issues in already created reports, you may need to fix the issues manually on Power BI end itself. 
After updating Schema the data will be pushed according to new columns, if you want to push all the data with new columns 
then you need to first delete the existing data reset the last synchronization date and then export the data again."
                            invisible="state != 'published'" />
                        <button name="action_unpublish_table"
                            type="object"
                            string="Unpublish"
                            class="btn btn-danger"
                            invisible="state != 'published' or not fabric_group" />
                        <field name="state" widget="statusbar" />
                    </header>
                    <header invisible="dataset_type != 'import'">
                        <field name="state" widget="statusbar" />
                    </header>
                    <sheet>
                        <field name="is_modified" invisible="1" />
                        <div class="oe_button_box" name="button_box"
                            invisible="dataset_type == 'import'">
                            <button type="object"
                                name="create_server_action"
                                string='Add Server Action'
                                class="oe_stat_button"
                                icon="fa-server"
                                invisible="state != 'published' or export_action > 0"
                            />
                            <button type="object"
                                name="delete_server_action"
                                string='Delete Server Action'
                                class="oe_stat_button"
                                icon="fa-trash"
                                invisible="state != 'published' or export_action == 0"
                            />
                            <button class="oe_stat_button text-success"
                                icon="fa-check-circle text-success"
                                invisible="state == 'topublish' or is_modified == True">
                                <strong>Schema Validated</strong>
                            </button>
                            <button class="oe_stat_button text-info"
                                icon="fa-exclamation-circle text-danger"
                                invisible="state == 'topublish' or is_modified == False">
                                <strong>Update Schema</strong>
                            </button>
                            <button name="action_toggle_cron" type="object" class="oe_stat_button"
                                invisible="state != 'published'">
                                <div>
                                    <field name="run_cron" widget="boolean_toggle" />
                                    <strong class="text-success" invisible="not run_cron"> Cron
                                        Enabled</strong>
                                    <strong class="text-muted" invisible="run_cron"> Cron Disabled</strong>
                                </div>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" readonly="is_published == True" />
                                <field name="database_id" readonly="is_published == True"
                                    invisible="not context.get('fabric_group')" />
                                <field name="dataset_id" readonly="is_published == True"
                                    invisible="context.get('fabric_group')" />
                                <field name="model_id" options="{'no_create':True}"
                                    readonly="is_published == True" />
                                <field name="data_export_mode" invisible="dataset_type == 'import'" />
                                <field name="page_size" invisible="dataset_type == 'push'"/>
                            </group>
                            <group>
                                <field name="create_uid" readonly="1" />
                                <field name="create_date" readonly="1" />
                                <field name="write_date" />
                                <field name="model_name" invisible="1" />
                                <field name="export_action" invisible="1" />
                                <field name="is_published" invisible="1" />
                                <field name="use_relation" readonly="is_published == True"
                                    invisible="not dataset_id" />
                                <field name="last_sync_datetime"
                                    invisible="dataset_type == 'import'" />
                            </group>

                        </group>
                        <notebook>
                            <page string="Columns" name="columns">

                                <label for="select_all_columns" string="Select all Columns" />
                                <field name="select_all_columns" class="m-2" />

                                <field name="column_ids">
                                    <list>
                                        <field name="sequence" widget="handle" />
                                        <field name="name" />
                                        <field name="field_id" />
                                        <field name="label" />
                                        <field name="field_type" />
                                    </list>
                                    <form>
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="field_id"
                                                        domain="[('model_id','=',parent.model_id),('ttype','not in',['one2many'])]" />
                                                    <field name="label" />
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Filter Detail">
                                <group>

                                    <field name="filter_domain" widget="domain"
                                        options="{'model': 'model_name'}" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter />
                </form>
            </field>
        </record>

        <record id="powerbi_table_view_tree" model="ir.ui.view">
            <field name="name">powerbi.table.view.tree</field>
            <field name="model">powerbi.table</field>
            <field name="type">list</field>
            <field name="arch" type="xml">
                <list string="Power BI Table">
                    <field name="name" />
                    <field name="database_id" column_invisible="not context.get('fabric_group')" />
                    <field name="dataset_id" column_invisible="context.get('fabric_group')" />
                    <field name="state"
                        decoration-success="state == 'published'"
                        decoration-info="state == 'topublish'"
                        widget="badge" optional="show" />
                    <field name="model_id" />
                    <field name="create_date" />
                    <field name="create_uid" widget="many2one_avatar_user" />
                    <field name="write_date" />
                </list>
            </field>
        </record>

        <record id="powerbi_table_view_search" model="ir.ui.view">
            <field name="name">powerbi.table.view.search</field>
            <field name="model">powerbi.table</field>
            <field name="arch" type="xml">
                <search>
                    <filter string="Published" name="publish" domain="[('is_published','=',True)]" />
                    <filter string="To Publish" name="topublish"
                        domain="[('is_published','=',False)]" />
                    <group expand="0" string="Group By">
                        <filter string="KQL Database" name="group_by_database"
                            invisible="not context.get('fabric_group')"
                            context="{'group_by':'database_id'}" />
                        <filter string="Dataset" name="group_by_dataset"
                            invisible="context.get('fabric_group')"
                            context="{'group_by':'dataset_id'}" />
                        <filter string="Model" name="group_by_model"
                            context="{'group_by':'model_id'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="powerbi_table_action_tree" model="ir.actions.act_window">
            <field name="name">Power BI Table</field>
            <field name="res_model">powerbi.table</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="powerbi_table_view_tree" />
        </record>

    </data>
</odoo>

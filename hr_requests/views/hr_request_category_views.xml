<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hr_request_category_tree" model="ir.ui.view">
        <field name="name">hr.request.category.tree</field>
        <field name="model">hr.request.category</field>
        <field name="arch" type="xml">
            <list string="HR Request Categories" default_order="sequence" create="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="employee_classification"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_request_category_form" model="ir.ui.view">
        <field name="name">hr.request.category.form</field>
        <field name="model">hr.request.category</field>
        <field name="arch" type="xml">
            <form string="HR Request Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="employee_classification"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_request_category_search" model="ir.ui.view">
        <field name="name">hr.request.category.search</field>
        <field name="model">hr.request.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name"/>
                <field name="employee_classification"/>
                <separator/>
                <filter string="Employee Request" name="employee" domain="[('employee_classification', '=', 'employee')]"/>
                <filter string="Manager Request" name="manager" domain="[('employee_classification', '=', 'manager')]"/>
                <group expand="0" string="Group By">
                    <filter string="Employee Classification" name="group_classification" context="{'group_by': 'employee_classification'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_request_category" model="ir.actions.act_window">
        <field name="name">Request Categories</field>
        <field name="res_model">hr.request.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_request_category_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new request category
            </p>
        </field>
    </record>
</odoo>

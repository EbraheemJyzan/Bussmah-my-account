<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_request_stage_form_inherit_hr" model="ir.ui.view">
        <field name="name">request.stage.form.inherit.hr</field>
        <field name="model">request.stage</field>
        <field name="inherit_id" ref="request.request_stage_from_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="after">
                <field name="hr_stage_selection"/>
            </xpath>
        </field>
    </record>
</odoo>

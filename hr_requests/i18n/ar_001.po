#. module: hr_requests
#: model:mail.template,subject:hr_requests.email_template_hr_request_submitted
msgid ""
"New HR Request Submitted: {{ object.name }} - {{ object.type_id.name or '-' "
"}}"
msgstr ""
"تم تقديم طلب موارد بشرية جديد: {{ object.name }} - {{ object.type_id.name or"
" '-' }}"

#. module: hr_requests
#: model:mail.template,body_html:hr_requests.email_template_hr_request_submitted
msgid ""
"<div style=\"margin: 0px; padding: 0px;\" dir=\"ltr\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 14px; text-align: left; line-height: 1.6;\">\n"
"                        Sender: <strong>Human Resources Department - Bussma</strong><br/><br/>\n"
"                        Dear <strong t-out=\"ctx.get('manager_name') or 'HR Manager'\"/>,<br/><br/>\n"
"                        A new HR request has been submitted and is awaiting your review.<br/>\n"
"                        <strong>An HR request has been sent to you. Kindly review it.</strong><br/><br/>\n"
"                        <strong>Request Details:</strong>\n"
"                        </p><ul style=\"line-height: 1.8;\">\n"
"                            <li><strong>Request Number:</strong> <t t-out=\"object.name or '-'\"/></li>\n"
"                            <li><strong>Employee:</strong> <t t-out=\"object.user_id.name or '-'\"/></li>\n"
"                            <li><strong>Request Category:</strong> <t t-out=\"object.category_id.name or '-'\"/></li>\n"
"                            <li><strong>Request Type:</strong> <t t-out=\"object.type_id.name or '-'\"/></li>\n"
"                            <li><strong>Request Date:</strong> <t t-out=\"object.date or '-'\"/></li>\n"
"                        </ul>\n"
"                        <br/>\n"
"                        You can view and process the request by clicking the button below.\n"
"                    \n"
"                    <div style=\"margin: 20px 0px; text-align: center;\">\n"
"                        <a t-att-href=\"object.get_hr_request_url()\" style=\"background-color: #007bff; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 14px; display: inline-block;\">\n"
"                            View Request in System\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\" dir=\"rtl\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 14px; text-align: right; line-height: 1.6;\">\n"
"                        المرسل: <strong>إدارة الموارد البشرية - بصمة</strong><br/><br/>\n"
"                        عزيزي <strong t-out=\"ctx.get('manager_name') or 'مدير الموارد البشرية'\"/>،<br/><br/>\n"
"                        تم تقديم طلب موارد بشرية جديد وبانتظار مراجعتكم الكريمة.<br/>\n"
"                        <strong>تم إرسال طلب موارد بشرية إليكم، يرجى التكرم بالاطلاع والمراجعة.</strong><br/><br/>\n"
"                        <strong>تفاصيل الطلب:</strong>\n"
"                        </p><ul style=\"line-height: 1.8;\">\n"
"                            <li><strong>رقم الطلب:</strong> <t t-out=\"object.name or '-'\"/></li>\n"
"                            <li><strong>الموظف:</strong> <t t-out=\"object.user_id.name or '-'\"/></li>\n"
"                            <li><strong>تصنيف الطلب:</strong> <t t-out=\"object.category_id.name or '-'\"/></li>\n"
"                            <li><strong>نوع الطلب:</strong> <t t-out=\"object.type_id.name or '-'\"/></li>\n"
"                            <li><strong>تاريخ الطلب:</strong> <t t-out=\"object.date or '-'\"/></li>\n"
"                        </ul>\n"
"                        <br/>\n"
"                        يمكنكم الاطلاع على الطلب واتخاذ الإجراء اللازم من خلال الضغط على الزر أدناه.\n"
"                    \n"
"                    <div style=\"margin: 20px 0px; text-align: center;\">\n"
"                        <a t-att-href=\"object.get_hr_request_url()\" style=\"background-color: #007bff; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 14px; display: inline-block;\">\n"
"                            معاينة الطلب في النظام\n"
"                        </a>\n"
"                    </div>\n"
"                </div>\n"
"            "


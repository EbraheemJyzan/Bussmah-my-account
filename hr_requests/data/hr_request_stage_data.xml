<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Request Type for HR Request -->
        <record id="request_type_hr" model="request.type">
            <field name="name">HR Request</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
        </record>

        <!-- HR Request Stages (request.stage) -->
        <record id="stage_hr_draft" model="request.stage">
            <field name="name">Draft</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">1</field>
            <field name="state">draft</field>
            <field name="hr_stage_selection">hr_draft</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_submitted" model="request.stage">
            <field name="name">Submitted</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">2</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_submitted</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_commercial" model="request.stage">
            <field name="name">Commercial Sector Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">10</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_commercial</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_projects" model="request.stage">
            <field name="name">Project Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">15</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_projects</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_marketing" model="request.stage">
            <field name="name">Marketing Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">20</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_marketing</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_legal" model="request.stage">
            <field name="name">Legal Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">25</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_legal</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_finance" model="request.stage">
            <field name="name">Financial Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">30</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_finance</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_hr" model="request.stage">
            <field name="name">Human Resources Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">35</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_hr</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_assets" model="request.stage">
            <field name="name">Assets &amp; Investment Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">40</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_assets</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_it" model="request.stage">
            <field name="name">IT Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">45</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_it</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_dept_executive" model="request.stage">
            <field name="name">Executive Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">50</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_dept_executive</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_approval" model="request.stage">
            <field name="name">HR Approval</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">95</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">hr_approval</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_approved" model="request.stage">
            <field name="name">Approved</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">100</field>
            <field name="state">done</field>
            <field name="hr_stage_selection">hr_approved</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <record id="stage_hr_rejected" model="request.stage">
            <field name="name">Rejected</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">110</field>
            <field name="state">cancel</field>
            <field name="hr_stage_selection">hr_rejected</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_hr')])]"/>
        </record>

        <!-- Request Type for Clearance -->
        <record id="request_type_clearance" model="request.type">
            <field name="name">Clearance Process</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
        </record>

        <!-- Clearance Stages -->
        <record id="stage_clearance_draft" model="request.stage">
            <field name="name">Draft</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">1</field>
            <field name="state">draft</field>
            <field name="hr_stage_selection">clearance_draft</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_clearance')])]"/>
        </record>

        <record id="stage_clearance_emp_dept" model="request.stage">
            <field name="name">Employee Management</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">2</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">clearance_emp_dept</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_clearance')])]"/>
        </record>

        <record id="stage_clearance_departments" model="request.stage">
            <field name="name">Concerned Departments</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">3</field>
            <field name="state">in_progress</field>
            <field name="hr_stage_selection">clearance_departments</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_clearance')])]"/>
        </record>

        <record id="stage_clearance_archive" model="request.stage">
            <field name="name">Archive</field>
            <field name="res_model">hr.request</field>
            <field name="res_model_id" ref="model_hr_request"/>
            <field name="sequence">4</field>
            <field name="state">done</field>
            <field name="hr_stage_selection">clearance_archive</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('request_type_clearance')])]"/>
        </record>

        <!-- ================================================================ -->
        <!-- Fixed Department Approval Line Data (hr.request.dept.line)       -->
        <!-- ================================================================ -->
        <record id="dept_line_draft" model="hr.request.dept.line">
            <field name="fixed_stage">draft</field>
            <field name="sequence">1</field>
            <field name="is_fixed">True</field>
        </record>

        <record id="dept_line_submitted" model="hr.request.dept.line">
            <field name="fixed_stage">submitted</field>
            <field name="sequence">2</field>
            <field name="is_fixed">True</field>
        </record>

        <record id="dept_line_hr_approval" model="hr.request.dept.line">
            <field name="fixed_stage">hr_approval</field>
            <field name="sequence">95</field>
            <field name="is_fixed">True</field>
        </record>

        <record id="dept_line_approved" model="hr.request.dept.line">
            <field name="fixed_stage">approved</field>
            <field name="sequence">100</field>
            <field name="is_fixed">True</field>
        </record>

        <record id="dept_line_rejected" model="hr.request.dept.line">
            <field name="fixed_stage">rejected</field>
            <field name="sequence">101</field>
            <field name="is_fixed">True</field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ===== Mail Template: Approved ===== -->
        <record id="email_template_hr_request_approved" model="mail.template">
            <field name="name">HR Request: Request Approved</field>
            <field name="model_id" ref="hr_requests.model_hr_request"/>
            <field name="subject">Your HR Request {{ object.name }} Has Been Approved</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;" dir="ltr">
                    <p style="margin: 0px; padding: 0px; font-size: 14px; text-align: left; line-height: 1.6;">
                        Sender: <strong>Human Resources Department - Bussma</strong><br/><br/>
                        Dear Employee,<br/><br/>
                        We are pleased to inform you that your request submitted to the Human Resources Department has been <strong>approved</strong>.<br/><br/>
                        <strong>Request Details:</strong>
                        <ul style="line-height: 1.8;">
                            <li><strong>Request Number:</strong> <t t-out="object.name or '-'"/></li>
                            <li><strong>Request Category:</strong> <t t-out="object.category_id.name or '-'"/></li>
                            <li><strong>Request Type:</strong> <t t-out="object.type_id.name or '-'"/></li>
                            <li><strong>Request Date:</strong> <t t-out="object.date or '-'"/></li>
                        </ul>
                        <br/>
                        You can view the details of the request by clicking the link below.
                    </p>
                    <div style="margin: 20px 0px; text-align: center;">
                        <a t-att-href="object.get_hr_request_url()"
                           style="background-color: #28a745; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 14px; display: inline-block;">
                            View Request in System
                        </a>
                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- ===== Mail Template: Rejected ===== -->
        <record id="email_template_hr_request_rejected" model="mail.template">
            <field name="name">HR Request: Request Rejected</field>
            <field name="model_id" ref="hr_requests.model_hr_request"/>
            <field name="subject">Your HR Request {{ object.name }} Has Been Rejected</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;" dir="ltr">
                    <p style="margin: 0px; padding: 0px; font-size: 14px; text-align: left; line-height: 1.6;">
                        Sender: <strong>Human Resources Department - Bussma</strong><br/><br/>
                        Dear Employee,<br/><br/>
                        We regret to inform you that your request submitted to the Human Resources Department has been <strong>rejected</strong>.<br/><br/>
                        <strong>Request Details:</strong>
                        <ul style="line-height: 1.8;">
                            <li><strong>Request Number:</strong> <t t-out="object.name or '-'"/></li>
                            <li><strong>Request Category:</strong> <t t-out="object.category_id.name or '-'"/></li>
                            <li><strong>Request Type:</strong> <t t-out="object.type_id.name or '-'"/></li>
                            <li><strong>Request Date:</strong> <t t-out="object.date or '-'"/></li>
                        </ul>
                        <br/>
                        For inquiries or to submit a new request, you can view the details of the request by clicking the link below.
                    </p>
                    <div style="margin: 20px 0px; text-align: center;">
                        <a t-att-href="object.get_hr_request_url()"
                           style="background-color: #dc3545; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 14px; display: inline-block;">
                            View Request in System
                        </a>
                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="email_template_hr_request_submitted" model="mail.template">
            <field name="name">HR Request: Request Submitted to HR Manager</field>
            <field name="model_id" ref="hr_requests.model_hr_request"/>
            <field name="subject">New HR Request Submitted: {{ object.name }} - {{ object.type_id.name or '-' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;" dir="ltr">
                    <p style="margin: 0px; padding: 0px; font-size: 14px; text-align: left; line-height: 1.6;">
                        Sender: <strong>Human Resources Department - Bussma</strong><br/><br/>
                        Dear <strong t-out="ctx.get('manager_name') or 'HR Manager'"/>,<br/><br/>
                        A new HR request has been submitted and is awaiting your review.<br/>
                        <strong>An HR request has been sent to you. Kindly review it.</strong><br/><br/>
                        <strong>Request Details:</strong>
                        <ul style="line-height: 1.8;">
                            <li><strong>Request Number:</strong> <t t-out="object.name or '-'"/></li>
                            <li><strong>Employee:</strong> <t t-out="object.user_id.name or '-'"/></li>
                            <li><strong>Request Category:</strong> <t t-out="object.category_id.name or '-'"/></li>
                            <li><strong>Request Type:</strong> <t t-out="object.type_id.name or '-'"/></li>
                            <li><strong>Request Date:</strong> <t t-out="object.date or '-'"/></li>
                        </ul>
                        <br/>
                        You can view and process the request by clicking the button below.
                    </p>
                    <div style="margin: 20px 0px; text-align: center;">
                        <a t-att-href="object.get_hr_request_url()"
                           style="background-color: #007bff; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 14px; display: inline-block;">
                            View Request in System
                        </a>
                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- ===== Mail Template: Clearance Employee Manager ===== -->
        <record id="email_template_clearance_emp_manager" model="mail.template">
            <field name="name">Clearance: Employee Manager Notification</field>
            <field name="model_id" ref="hr_requests.model_hr_request"/>
            <field name="email_to">{{ object.employee_manager_id.email }}</field>
            <field name="subject">Clearance Request: {{ object.user_id.name or '-' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;" dir="ltr">
                    <p style="margin: 0px; padding: 0px; font-size: 14px; text-align: left; line-height: 1.6;">
                        Dear Manager,<br/><br/>
                        A clearance request has been submitted for employee <strong><t t-out="object.user_id.name or '-'"/></strong>.<br/>
                        Please kindly take the necessary actions and update the custody status and notes for your department.<br/><br/>
                        <strong>Request Details:</strong>
                        <ul style="line-height: 1.8;">
                            <li><strong>Request Number:</strong> <t t-out="object.name or '-'"/></li>
                            <li><strong>Procedure Type:</strong> <t t-out="object.procedure_types or '-'"/></li>
                            <li><strong>Request Date:</strong> <t t-out="object.date or '-'"/></li>
                        </ul>
                    </p>
                    <div style="margin: 20px 0px; text-align: center;">
                        <a t-att-href="object.get_formview_url()"
                           style="background-color: #007bff; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 14px; display: inline-block;">
                            View Request in System
                        </a>
                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>


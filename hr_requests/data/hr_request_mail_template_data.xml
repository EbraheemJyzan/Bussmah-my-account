                        <br/>
                        You can view and process the request by clicking the button below.
                    </p>
                    <div style="margin: 20px 0px; text-align: center;">
                        <a t-att-href="object.get_hr_request_url()"
                           style="background-color: #28a745; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 14px; display: inline-block;">
                            View Request in System
                        </a>
                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>

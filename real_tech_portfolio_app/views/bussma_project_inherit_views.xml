<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Inherit Bussma Project Form View -->
        <record id="view_bussma_project_form_inherit_real_tech" model="ir.ui.view">
            <field name="name">bussma.project.form.inherit.real.tech</field>
            <field name="model">bussma.project</field>
            <field name="inherit_id" ref="sales_and_auction_management.view_bussma_project_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_toggle_real_tech_portfolio_app"
                            type="object"
                            string="Real Tech Portfolio App"
                            class="btn-outline-primary"
                            confirm="Are you sure you want to add this project to Real Tech App?"
                            invisible="is_real_tech_portfolio_app"/>
                </xpath>
                <xpath expr="//sheet/div[@name='button_box']" position="before">
                    <field name="is_real_tech_portfolio_app" invisible="1"/>
                    <widget name="web_ribbon" title="Real Tech App" bg_color="text-bg-info" invisible="not is_real_tech_portfolio_app"/>
                </xpath>
            </field>
        </record>

        <!-- Dedicated Kanban View for Real Tech Portfolio App (English Labels) -->
        <record id="view_bussma_project_real_tech_kanban" model="ir.ui.view">
            <field name="name">bussma.project.real.tech.kanban</field>
            <field name="model">bussma.project</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" create="false" sample="1">
                    <field name="id"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="project_type"/>
                    <field name="project_category"/>
                    <field name="entries_count"/>
                    <field name="is_basic"/>
                    <templates>
                        <t t-name="card">
                            <t t-set="project_theme" t-value="record.project_type.raw_value == 'sales' ? 'theme-project-sales' : record.project_type.raw_value == 'auction_pvt' ? 'theme-project-pvt' : record.project_type.raw_value == 'auction_enf' ? 'theme-project-enf' : 'theme-project-city'"/>
                            <div t-attf-class="oe_kanban_global_click o_kanban_record d-flex flex-column justify-content-between p-3 border-start border-4 bussma-project-kanban-card #{project_theme} #{record.is_basic.raw_value ? 'bussma-project-basic-special' : ''}">                                
                                <div class="d-flex justify-content-between align-items-start mb-2 mt-4">
                                    <div class="fw-bold text-truncate" style="font-size: 15px; color: #1e293b; max-width: 70%;">
                                        [<field name="code"/>] <field name="name"/>
                                    </div>
                                    
                                    <!-- Tailored Colored Badges for Project Types -->
                                    <t t-if="record.project_type.raw_value == 'sales'">
                                        <span class="badge" style="font-size: 11px; padding: 4px 8px; border-radius: 6px; background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe;">
                                            Direct Sales
                                        </span>
                                    </t>
                                    <t t-if="record.project_type.raw_value == 'auction_pvt'">
                                        <span class="badge" style="font-size: 11px; padding: 4px 8px; border-radius: 6px; background-color: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0;">
                                            Private Auction
                                        </span>
                                    </t>
                                    <t t-if="record.project_type.raw_value == 'auction_enf'">
                                        <span class="badge" style="font-size: 11px; padding: 4px 8px; border-radius: 6px; background-color: #fff7ed; color: #9a3412; border: 1px solid #ffedd5;">
                                            Eanfaz Auction
                                        </span>
                                    </t>
                                    <t t-if="record.project_type.raw_value == 'city'">
                                        <span class="badge" style="font-size: 11px; padding: 4px 8px; border-radius: 6px; background-color: #f5f3ff; color: #5b21b6; border: 1px solid #ddd6fe;">
                                            Cities
                                        </span>
                                    </t>
                                </div>

                                <div class="mb-2" t-if="record.project_category.raw_value">
                                    <span class="badge text-bg-light border text-dark" style="font-size: 11px; padding: 3px 6px; border-radius: 4px; font-weight: 500;">
                                        <i class="fa fa-folder-open-o" title="Category" style="color: #64748b; margin-left: 2px;"/>
                                        <field name="project_category"/>
                                    </span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top border-light">
                                    <div class="d-flex align-items-center gap-1 text-muted" style="font-size: 13px;">
                                        <i class="fa fa-building-o" style="color: #64748b;"/>
                                        <span>Properties:</span>
                                        <span class="fw-bold text-dark"><field name="entries_count"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Window Action: Real Tech Portfolio App -->
        <record id="action_bussma_project_real_tech" model="ir.actions.act_window">
            <field name="name">Real Tech Portfolio App</field>
            <field name="res_model">bussma.project</field>
            <field name="view_mode">kanban,list</field>
            <field name="view_id" ref="view_bussma_project_real_tech_kanban"/>
            <field name="domain">[('is_real_tech_portfolio_app', '=', True)]</field>
            <field name="context">
                {'create': False, 'delete': False}
            </field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Dose’t have any data for this app
                </p>
            </field>
        </record>

        <!-- Explicit Action View Link for Kanban -->
        <record id="action_bussma_project_real_tech_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_bussma_project_real_tech_kanban"/>
            <field name="act_window_id" ref="action_bussma_project_real_tech"/>
        </record>
    </data>
</odoo>

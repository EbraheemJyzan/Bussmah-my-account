<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View auditlog.autovacuum View Tree -->
    <record id="view_auditlog_autovacuum_tree" model="ir.ui.view">
        <field name="name">view.auditlog.autovacuum.tree</field>
        <field name="model">auditlog.autovacuum</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="from_date" />
                <field name="to_date" />
            </list>
        </field>
    </record>

    <!-- View auditlog.autovacuum form -->
    <record id="view_auditlog_autovacuum_form" model="ir.ui.view">
        <field name="name">view.auditlog.autovacuum.form</field>
        <field name="model">auditlog.autovacuum</field>
        <field name="arch" type="xml">
            <form string="Auditlog Autovacuum">
                <header>
                    <button string="Run Autovacuum" icon="fa-trash" name="autovacuum" type="object" invisible="state == 'done'" class="oe_highlight" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h2>
                            <field name="name" readonly="state == 'done'" placeholder="Name..." />
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="from_date" readonly="state == 'done'" required="1" />
                        </group>
                        <group>
                            <field name="to_date" readonly="state == 'done'" required="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View auditlog.autovacuum search -->
    <record id="view_auditlog_autovacuum_search" model="ir.ui.view">
        <field name="name">view.auditlog.autovacuum.search</field>
        <field name="model">auditlog.autovacuum</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Action auditlog.autovacuum -->
    <record id="action_auditlog_autovacuum" model="ir.actions.act_window">
        <field name="name">Delete movement records</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">auditlog.autovacuum</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

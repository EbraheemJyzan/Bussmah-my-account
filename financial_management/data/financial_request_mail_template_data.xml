<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Email Template for Financial Request Archived Notification -->
        <record id="email_template_financial_request_archived" model="mail.template">
            <field name="name">Financial Request: Request Archived Notification</field>
            <field name="model_id" ref="financial_management.model_financial_request"/>
            <field name="subject">Financial Request Archived &amp; Completed Notification {{ object.code }} - {{ object.project_name or '' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;" dir="ltr">
                    <p style="margin: 0px; padding: 0px; font-size: 14px; text-align: left; line-height: 1.6;">
                        Sender: <strong>Financial Management System - Bussma</strong><br/><br/>
                        Dear User,<br/><br/>
                        Please be informed that all approvals for the Financial Request have been completed and archived under number: <strong><t t-out="object.code or 'N/A'"/></strong>.<br/><br/>
                        <strong>Request Details:</strong>
                        <ul style="line-height: 1.8;">
                            <li><strong>Request Number:</strong> <t t-out="object.code or '-'"/></li>
                            <li><strong>Requester:</strong> <t t-out="object.requester_id.name or '-'"/></li>
                            <li><strong>Project Name:</strong> <t t-out="object.project_name or '-'"/></li>
                            <li><strong>Invoice Type:</strong> <t t-out="dict(object._fields['invoice_type']._description_selection(object.env)).get(object.invoice_type) or '-'"/></li>
                            <li><strong>Request Type:</strong> <t t-out="dict(object._fields['request_type']._description_selection(object.env)).get(object.request_type) or '-'"/></li>
                            <li><strong>Invoice Amount:</strong> <t t-out="object.invoice_amount or 0.0"/> <t t-out="object.currency_id.symbol or 'SAR'"/></li>
                            <li><strong>Supplier Name:</strong> <t t-out="object.supplier_name or '-'"/></li>
                        </ul>
                        <br/>
                        You can view the details of the request by clicking the link below.
                    </p>
                    <div style="margin: 20px 0px; text-align: center;">
                        <a t-att-href="'%s/web#id=%s&amp;model=%s&amp;view_type=form' % (object.get_base_url(), object.id, object._name)"
                           style="background-color: #875A7B; padding: 10px 20px; text-decoration: none; color: #ffffff; border-radius: 5px; font-size: 14px; display: inline-block;">
                            View Request in System
                        </a>
                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>

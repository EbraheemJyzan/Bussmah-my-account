<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Financial Requests -->
        <record id="seq_financial_request" model="ir.sequence">
            <field name="name">Financial Request Sequence</field>
            <field name="code">financial.request</field>
            <field name="prefix">FIN/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

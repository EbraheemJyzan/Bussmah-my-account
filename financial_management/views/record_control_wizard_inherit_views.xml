<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_record_control_wizard_form_financial" model="ir.ui.view">
        <field name="name">record.control.wizard.form.financial</field>
        <field name="model">record.control.wizard</field>
        <field name="inherit_id" ref="sales_and_auction_management.view_record_control_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_delete']" position="before">
                <field name="financial_request_id" invisible="control_type != 'financial_request'" required="control_type == 'financial_request'" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>

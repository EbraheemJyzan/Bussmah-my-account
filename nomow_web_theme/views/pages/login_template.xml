<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="nomow_web_theme.login_layout_inherit" inherit_id="web.login_layout">
        <xpath expr="//div[contains(@class,'container')]" position="replace">
            <div class="container-fluid py-5" t-attf-dir="#{'rtl' if request.env.lang and request.env.lang.startswith('ar') else 'ltr'}">
                <div class="row justify-content-center">
                    <div class="col-lg-4 col-md-6">
                        <div class="card border-0 shadow-sm registration-card">
                            <div class="card-body p-4 p-md-5">
    
                                <div class="text-center mb-4">
                                    <div class="mb-3">
                                        <t t-if="logo_company and logo_company.logo">
                                            <img
                                                t-attf-src="/web/image/res.company/#{logo_company.id}/logo"
                                                t-att-alt="logo_company.name" class="img img-fluid"
                                                style="max-height: 120px;" />
                                        </t>
                                        <t t-else="">
                                            <span
                                                class="avatar-placeholder rounded-circle d-inline-flex align-items-center justify-content-center"
                                                style="width:60px;height:60px;">
                                                <i class="fa fa-lock fa-2x" />
                                            </span>
                                        </t>
                                    </div>
                                    <h2 class="fw-bold mb-1">Welcome Back</h2>
                                    <p class="text-muted small">
                                        Please enter your login details
                                    </p>
                                </div>
                                <t t-out="0"/>
                                <!-- <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                                    <t t-if="not disable_database_manager">
                                        <a class="border-end pe-2 me-1" href="/web/database/manager">Manage Databases</a>
                                    </t>
                                    <a href="https://www.odoo.com?utm_source=db&amp;utm_medium=auth" target="_blank">Powered by <span>Odoo</span></a>
                                </div> -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>

    </template>
    
    <template id="nomow_web_theme.login_inherit" inherit_id="web.login">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label d-flex justify-content-between">
                <span><i class="fa fa-envelope me-2 text-success" />Email</span>
            </label>
        </xpath>
        <xpath expr="//label[@for='password']" position="replace">
            <label for="password" class="form-label d-flex justify-content-between">
                <span><i class="fa fa-lock me-2 text-success" />Password</span>
                <a t-if="reset_password_enabled" class="btn btn-link btn-sm" tabindex="1" t-attf-href="/web/reset_password?{{ keep_query() }}">Reset Password</a>
            </label>
        </xpath>
        <xpath expr="//button[contains(@class,'btn-primary')]" position="replace">
            <button type="submit" class="btn btn-beneficiary-primary">
                <i class="fa fa-sign-in me-2"/>Log in
            </button>
        </xpath>
    </template>

    <template id="nomow_web_theme.fields_inherit" inherit_id="auth_signup.fields">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="fw-bold">
                <i class="fa fa-envelope me-2 text-success" />Your Email
            </label>
        </xpath>
        <xpath expr="//label[@for='name']" position="replace">
            <label for="name" class="fw-bold">
                <i class="fa fa-user me-2 text-success" />Your Name
            </label>
        </xpath>
        <xpath expr="//label[@for='password']" position="replace">
            <label for="password" class="fw-bold">
                <i class="fa fa-lock me-2 text-success" />Password
            </label>
        </xpath>
        <xpath expr="//label[@for='confirm_password']" position="replace">
            <label for="confirm_password" class="fw-bold">
                <i class="fa fa-lock me-2 text-success" />Confirm Password
            </label>
        </xpath>
    </template>

    <template id="nomow_web_theme.signup_inherit" inherit_id="auth_signup.signup">
        <xpath expr="//button" position="replace">
            <button type="submit" class="btn btn-beneficiary-primary mb-2">
                <span class="mx-2">Sign up</span>
            </button>
        </xpath>
    </template>

    <template id="nomow_web_theme.reset_password_inherit" inherit_id="auth_signup.reset_password">
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="col-form-label fw-bold">
                <i class="fa fa-envelope me-2 text-success" />Your Email
            </label>
        </xpath>
        <xpath expr="//button" position="replace">
            <button type="submit" class="btn btn-beneficiary-primary">
                <span class="mx-2">Reset Password</span>
            </button>
        </xpath>
    </template>

</odoo>
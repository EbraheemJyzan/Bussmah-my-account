<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Project Manager Group -->
        <record id="group_sales_project_manager" model="res.groups">
            <field name="name">Project Manager</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_commercial_sector_accountant" model="res.groups">
            <field name="name">Commercial Sector Accountant</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_collection_evacuation_officer" model="res.groups">
            <field name="name">Collection and Evacuation Officer</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_system_admin" model="res.groups">
            <field name="name">System Admin</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
        <!-- Record Rules -->
        <record id="entries_phase2_task_attachment_rule" model="ir.rule">
            <field name="name">Sales and Auction Phase 2 Task Attachments</field>
            <field name="model_id" ref="base.model_ir_attachment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Access for users assigned to the task, the project manager of the property, or the creator -->
        <record id="rule_entries_phase2_task_user" model="ir.rule">
            <field name="name">Sales and Auction Task: Personal or Managed Tasks</field>
            <field name="model_id" ref="model_project_task"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('entry_id.project_manager_id', '=', user.id), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>

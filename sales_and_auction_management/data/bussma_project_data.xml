<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="project_sales_basic" model="bussma.project">
            <field name="name">محفظة العقارات الأساسية بيع مباشر</field>
            <field name="project_type">sales</field>
            <field name="is_basic">True</field>
        </record>

        <record id="project_auctions_pvt_basic" model="bussma.project">
            <field name="name">محفظة العقارات الأساسية مزاد - خاص</field>
            <field name="project_type">auction_pvt</field>
            <field name="is_basic">True</field>
        </record>

        <record id="project_auctions_enf_basic" model="bussma.project">
            <field name="name">محفظة العقارات الأساسية مزاد - انفاذ</field>
            <field name="project_type">auction_enf</field>
            <field name="is_basic">True</field>
        </record>

        <record id="project_cities_basic" model="bussma.project">
            <field name="name">محفظة العقارات الأساسية مدن</field>
            <field name="project_type">city</field>
            <field name="is_basic">True</field>
        </record>

        <!-- ================================================================ -->
        <!-- Request Types for Bussma Project                                 -->
        <!-- ================================================================ -->
        <!-- Sales Project Type -->
        <record id="bussma_project_type_sales" model="request.type">
            <field name="name">Sales</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="res_model">bussma.project</field>
        </record>
        <!-- Private Auctions Project Type -->
        <record id="bussma_project_type_auction_pvt" model="request.type">
            <field name="name">Auctions - Private</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="res_model">bussma.project</field>
        </record>
        <!-- Cities Auctions Project Type -->
        <record id="bussma_project_type_auction_city" model="request.type">
            <field name="name">Auctions - Cities</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="res_model">bussma.project</field>
        </record>
        <!-- Eanfaz Auctions Project Type -->
        <record id="bussma_project_type_auction_enf" model="request.type">
            <field name="name">Auctions - Eanfaz</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="res_model">bussma.project</field>
        </record>

        <!-- ================================================================ -->
        <!-- Stages for Bussma Project                                         -->
        <!-- ================================================================ -->
        <!-- Initial Stage: Sales Project Management -->
        <record id="bussma_project_stage_sales_pm" model="request.stage">
            <field name="name">Project Management - Direct Sales</field>
            <field name="res_model">bussma.project</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="sequence">1</field>
            <field name="state">draft</field>
            <field name="bussma_project_stage_selection">bussma_project_sales_pm</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('bussma_project_type_sales')])]"/>
            <field name="hide_on_flag">True</field>
        </record>

        <!-- Initial Stage: Private Auction Project Management -->
        <record id="bussma_project_stage_pvt_pm" model="request.stage">
            <field name="name">Project Management - Private</field>
            <field name="res_model">bussma.project</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="sequence">1</field>
            <field name="state">draft</field>
            <field name="bussma_project_stage_selection">bussma_project_pvt_pm</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('bussma_project_type_auction_pvt')])]"/>
            <field name="hide_on_flag">True</field>
        </record>

        <!-- Initial Stage: Cities Auction Project Management -->
        <record id="bussma_project_stage_city_pm" model="request.stage">
            <field name="name">Project Management - Cities</field>
            <field name="res_model">bussma.project</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="sequence">1</field>
            <field name="state">draft</field>
            <field name="bussma_project_stage_selection">bussma_project_city_pm</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('bussma_project_type_auction_city')])]"/>
            <field name="hide_on_flag">True</field>
        </record>

        <!-- Initial Stage: Eanfaz Auction Project Management -->
        <record id="bussma_project_stage_enf_pm" model="request.stage">
            <field name="name">Project Management - Eanfaz</field>
            <field name="res_model">bussma.project</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="sequence">1</field>
            <field name="state">draft</field>
            <field name="bussma_project_stage_selection">bussma_project_enf_pm</field>
            <field name="request_type_ids" eval="[(6, 0, [ref('bussma_project_type_auction_enf')])]"/>
            <field name="hide_on_flag">True</field>
        </record>

        <!-- Shared Stage: Sales and Finance -->
        <record id="bussma_project_stage_sales_fin" model="request.stage">
            <field name="name">Sales and Finance</field>
            <field name="res_model">bussma.project</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="sequence">2</field>
            <field name="state">in_progress</field>
            <field name="bussma_project_stage_selection">bussma_project_sales_fin</field>
            <field name="request_type_ids" eval="[(6, 0, [
                ref('bussma_project_type_sales'),
                ref('bussma_project_type_auction_pvt'),
                ref('bussma_project_type_auction_city'),
                ref('bussma_project_type_auction_enf')
            ])]"/>
        </record>

        <!-- Shared Stage: Completed -->
        <record id="bussma_project_stage_completed" model="request.stage">
            <field name="name">Completed</field>
            <field name="res_model">bussma.project</field>
            <field name="res_model_id" ref="model_bussma_project"/>
            <field name="sequence">3</field>
            <field name="state">done</field>
            <field name="bussma_project_stage_selection">bussma_project_completed</field>
            <field name="request_type_ids" eval="[(6, 0, [
                ref('bussma_project_type_sales'),
                ref('bussma_project_type_auction_pvt'),
                ref('bussma_project_type_auction_city'),
                ref('bussma_project_type_auction_enf')
            ])]"/>
        </record>
    </data>
</odoo>

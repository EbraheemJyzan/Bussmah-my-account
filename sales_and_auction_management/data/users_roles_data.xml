<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ============================================== -->
        <!-- User Roles Mapping                             -->
        <!-- ============================================== -->
        <record id="role_sales_project_manager" model="res.users.role">
            <field name="name">Project Manager Role</field>
            <field name="implied_ids" eval="[(4, ref('group_sales_project_manager')), (4, ref('base.group_user'))]"/>
        </record>

        <record id="role_commercial_sector_accountant" model="res.users.role">
            <field name="name">Commercial Sector Accountant Role</field>
            <field name="implied_ids" eval="[(4, ref('group_commercial_sector_accountant')), (4, ref('base.group_user'))]"/>
        </record>

        <record id="role_collection_evacuation_officer" model="res.users.role">
            <field name="name">Collection and Evacuation Officer Role</field>
            <field name="implied_ids" eval="[(4, ref('group_collection_evacuation_officer')), (4, ref('base.group_user'))]"/>
        </record>

        <!-- ============================================== -->
        <!-- Users Creation                                 -->
        <!-- ============================================== -->
        <record id="user_sales_project_manager" model="res.users">
            <field name="name">Project Manager</field>
            <field name="login">sales_pm@gmail.com</field>
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
            <field name="tz">Asia/Riyadh</field>
        </record>

        <record id="user_commercial_sector_accountant" model="res.users">
            <field name="name">Commercial Sector Accountant</field>
            <field name="login">comm_accountant@gmail.com</field>
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
            <field name="tz">Asia/Riyadh</field>
        </record>

        <record id="user_collection_evacuation_officer" model="res.users">
            <field name="name">Collection and Evacuation Officer</field>
            <field name="login">collection_officer@gmail.com</field>
            <field name="groups_id" eval="[(4, ref('base.group_user'))]"/>
            <field name="tz">Asia/Riyadh</field>
        </record>
        <!-- ============================================== -->
        <!-- Linking Users to Roles                         -->
        <!-- ============================================== -->
        <record id="role_sales_project_manager_link" model="res.users.role.line">
            <field name="role_id" ref="role_sales_project_manager"/>
            <field name="user_id" ref="user_sales_project_manager"/>
        </record>
        <record id="role_commercial_sector_accountant_link" model="res.users.role.line">
            <field name="role_id" ref="role_commercial_sector_accountant"/>
            <field name="user_id" ref="user_commercial_sector_accountant"/>
        </record>
        <record id="role_collection_evacuation_officer_link" model="res.users.role.line">
            <field name="role_id" ref="role_collection_evacuation_officer"/>
            <field name="user_id" ref="user_collection_evacuation_officer"/>
        </record>
    </data>
</odoo>

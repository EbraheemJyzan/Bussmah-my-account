<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View for Required Tasks -->
        <record id="view_entries_project_task_list" model="ir.ui.view">
            <field name="name">entries.project.task.list</field>
            <field name="model">project.task</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="user_id" widget="many2one_avatar_user"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="task_attachments" widget="many2many_binary"/>
                    <field name="response"/>
                    <field name="is_completed" widget="boolean_toggle"/>
                    <field name="completion_attachments" widget="many2many_binary"/>
                </list>
            </field>
        </record>
    </data>
</odoo>

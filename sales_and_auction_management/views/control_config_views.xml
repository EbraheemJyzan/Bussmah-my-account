<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================================================================ -->
        <!-- Entries Studies Control View                                      -->
        <!-- ================================================================ -->
        <record id="view_entries_control_tree" model="ir.ui.view">
            <field name="name">entries.control.tree</field>
            <field name="model">entries</field>
            <field name="arch" type="xml">
                <list string="Entries Studies Control" decoration-bf="1" editable="top" create="0">
                    <field name="entrie_name" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="project_path"/>
                    <field name="stage_id" domain="[('res_model', '=', 'entries')]"/>
                    <field name="sales_auction_stage_selection" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="action_entries_control" model="ir.actions.act_window">
            <field name="name">Entries Studies Control</field>
            <field name="res_model">entries</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_entries_control_tree"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Control and override stages/paths for Entries studies.
                </p>
            </field>
        </record>

        <!-- ================================================================ -->
        <!-- Entries Phase 2 Control View                                      -->
        <!-- ================================================================ -->
        <record id="view_entries_control_tree" model="ir.ui.view">
            <field name="name">sales.auction.management.control.tree</field>
            <field name="model">sales.auction.management</field>
            <field name="arch" type="xml">
                <list string="Entries Phase 2 Control" decoration-bf="1" editable="top" create="0">
                    <field name="entrie_name" readonly="1"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="request_type_id" string="Path" readonly="0"/>
                    <field name="stage_id" domain="[('request_type_ids', '=', request_type_id)]"/>
                    <field name="sales_auction_stage_selection" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="action_entries_phase2_control" model="ir.actions.act_window">
            <field name="name">Entries Sales and Auction Control</field>
            <field name="res_model">sales.auction.management</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_entries_control_tree"/>
            <field name="context">{'delete': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Control and override stages/paths for Phase 2 Entries.
                </p>
            </field>
        </record>

    </data>
</odoo>

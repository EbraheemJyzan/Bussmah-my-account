<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record id="view_property_usage_type_list" model="ir.ui.view">
            <field name="name">property.usage.type.list</field>
            <field name="model">property.usage.type</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_property_usage_type_form" model="ir.ui.view">
            <field name="name">property.usage.type.form</field>
            <field name="model">property.usage.type</field>
            <field name="arch" type="xml">
                <form string="Property Usage Type">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_property_usage_type_search" model="ir.ui.view">
            <field name="name">property.usage.type.search</field>
            <field name="model">property.usage.type</field>
            <field name="arch" type="xml">
                <search string="Property Usage Types">
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
